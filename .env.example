# ============================================================
# PLANTILLA PUBLICA DE VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# NUNCA subas tus credenciales reales a GitHub.
# ============================================================

DB_HOST=localhost
DB_PORT=5432
# Base corporativa (tabla: reportes.reporte_promi)
DB_NAME=DataCenter_Promigas
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
# DB_SSL puede ser true si el servidor exige conexión cifrada
DB_SSL=false

# Puerto del servidor
PORT=4321

# ============================================================
# URL PÚBLICA Y HTTPS
# ============================================================
APP_HTTPS=auto
APP_BASE_URL=https://localhost:4321

# Dominios aceptados en la cabecera Host del DEV SERVER, separados por coma.
# ALLOWED_HOSTS=localhost,127.0.0.1

# Margen de gracia al apagar (ms)
SHUTDOWN_GRACE_MS=10000

# ============================================================
# RATE LIMITING (solo /api/*; hoy el portal no expone rutas /api)
# ============================================================
RATE_LIMIT_API_MAX=180
RATE_LIMIT_API_WINDOW_MS=60000
