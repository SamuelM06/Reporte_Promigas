{
  "name": "reporte-promigas",
  "version": "0.1.0",
  "description": "Gestión Diaria Promigas 2026 (Enero a Diciembre): portal de consulta del acumulado de gestión con identidad Xuma, sidebar auto-hide y API sobre DataCenter_Promigas.reportes.reporte_promi.",
  "type": "commonjs",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./scripts/serve.mjs",
    "servidor": "node ./scripts/lanzar-servidor.mjs",
    "servidor:oculto": "powershell -NoProfile -WindowStyle Hidden -Command \"Start-Process -FilePath 'cmd.exe' -ArgumentList '/c','iniciar-servidor.cmd' -WorkingDirectory (Get-Location).Path -WindowStyle Hidden\"",
    "scan-secrets": "node ./scripts/scan-secrets.mjs --strict",
    "scan-secrets:soft": "node ./scripts/scan-secrets.mjs",
    "db:init": "node ./scripts/db-init.mjs",
    "db:load": "node ./scripts/load-excel.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelM06/Reporte_Promigas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SamuelM06/Reporte_Promigas/issues"
  },
  "homepage": "https://github.com/SamuelM06/Reporte_Promigas#readme",
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "dotenv": "^17.4.2",
    "motion": "^13.4.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^6.0.3"
  }
}
