---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AnimatedBackground from '../components/ui/AnimatedBackground.astro';

interface Props {
  title?: string;
}
const { title = 'Gestión Diaria Promigas 2026' } = Astro.props;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <title>{title}</title>
    <script is:inline>
      // Tema persistente sin parpadeo: aplica la clase .dark antes del primer paint.
      // Además se re-aplica tras cada navegación: <ClientRouter /> copia los
      // atributos del <html> nuevo (que trae class="dark" por defecto) sobre el
      // documento vivo, lo que tumbaba el modo claro al cambiar de página.
      (function () {
        function aplicarTema() {
          try {
            var t = localStorage.getItem('xuma_tema');
            document.documentElement.classList.toggle('dark', t !== 'claro');
          } catch (e) {
            document.documentElement.classList.add('dark');
          }
        }
        aplicarTema();
        if (!window.__xumaTemaListo) {
          window.__xumaTemaListo = true;
          document.addEventListener('astro:after-swap', aplicarTema);
          document.addEventListener('astro:page-load', aplicarTema);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <AnimatedBackground />
    <slot />
  </body>
</html>