---
// Página: Análisis de Solicitudes.
// Solicitudes por producto (ranking de barras) + motivos de cancelación (tabla ranking).
// Datos de la capa de consulta; el componente solo pinta.
import { ruta } from '../lib/base';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import FiltrosGlobales from '../components/filtros/FiltrosGlobales.astro';
import RankingBarras from '../components/analisis/RankingBarras.astro';
import { cargaSSR, filtrosPorDefecto, getSolicitudesPorProducto, getMotivosCancelacion, getMetadatos, METADATOS_VACIOS, parseFiltros } from '../lib/query';
import { fmtInt } from '../lib/util';

const f = { ...filtrosPorDefecto(), ...parseFiltros(Astro.url) };
const claveFiltros = JSON.stringify(f);

const metadatos = await cargaSSR(`analisis/metadatos/${claveFiltros}`, getMetadatos(f), METADATOS_VACIOS, 300_000);
const prods: { items: { nombre: string; casos: number }[]; total: number } = await cargaSSR(`analisis/productos/${claveFiltros}`, getSolicitudesPorProducto(f), { items: [], total: 0 });
const motis: { items: { nombre: string; casos: number }[]; total: number } = await cargaSSR(`analisis/motivos/${claveFiltros}`, getMotivosCancelacion(f), { items: [], total: 0 });

const selMes = f.mes ?? [];
const selGas = f.gasera ?? [];
const selAseg = f.aseguradora ?? [];
const selCabina = f.cabina ?? [];
const selEstado = f.estado ?? [];
const selClasif = f.clasificacion ?? [];
const gaseras = metadatos.gaseras ?? [];
const aseguradoras = metadatos.aseguradoras ?? [];
const cabinas = metadatos.cabinas ?? [];
const estados = metadatos.estados ?? [];
const clasificaciones = metadatos.clasificaciones ?? [];
const mesesFiltro = (metadatos.meses ?? []).filter((m) => m !== 'SIN DATO');
const totalBase = metadatos.total ?? 0;

const mesesDisponibles = (metadatos.meses ?? []).filter(m => m !== 'SIN DATO');
const corteTexto = mesesDisponibles.length > 0
  ? `Corte · ${mesesDisponibles[0]} a ${mesesDisponibles[mesesDisponibles.length - 1]} 2026`
  : 'Corte · Enero a Diciembre 2026';

const cabinaLabel = selCabina.length === 1 ? selCabina[0] : 'Todas las cabinas';
const totalProd = prods.total;
const totalMoti = motis.total;
---

<SidebarLayout title="Análisis de Solicitudes · Promigas 2026" corteTexto={corteTexto}>
  <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">{corteTexto}</p>
      <h1 class="flex items-center gap-2 text-2xl font-extrabold md:text-3xl">
        <span class="kpi-ico" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="16 13 18 15 22 10"/></svg>' /> Análisis de <span class="texto-brillo">Solicitudes</span>
      </h1>
    </div>
  </div>

  <FiltrosGlobales
    action={ruta('/analisis-solicitudes')}
    opciones={{ mes: mesesFiltro, gasera: gaseras, aseguradora: aseguradoras, cabina: cabinas, estado: estados, clasificacion: clasificaciones }}
    actual={{ mes: selMes, gasera: selGas, aseguradora: selAseg, cabina: selCabina, estado: selEstado, clasificacion: selClasif }}
    totalFiltrado={totalProd}
    totalBase={totalBase}
  />

  <!-- Dos columnas: productos a la izquierda, motivos a la derecha -->
  <section class="mt-3 grid gap-4 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <RankingBarras
        titulo="Solicitudes por producto"
        subtitulo={`Volumen de solicitudes — ${cabinaLabel}`}
        etiquetaLider="PRODUCTO CON MÁS SOLICITUDES"
        items={prods.items}
        variante="barras"
        textoTotal="Total general de solicitudes"
      />
    </div>

    <div class="lg:col-span-7">
      <RankingBarras
        titulo={`Motivos de cancelación — ${cabinaLabel}`}
        subtitulo={`Top 10 de motivos · ${fmtInt(totalMoti)} casos`}
        etiquetaLider="PRINCIPAL MOTIVO"
        items={motis.items}
        limite={10}
        variante="tabla"
        textoTotal="Total Top 10"
      />
    </div>
  </section>

  <style>
    @media (max-width: 1000px) {
      .lg\:col-span-5 { grid-column: 1 / -1; }
      .lg\:col-span-7 { grid-column: 1 / -1; }
    }
  </style>
</SidebarLayout>