---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import FiltrosPanel from '../components/filtros/FiltrosPanel.astro';
import { cargaSSR, filtrosPorDefecto, getMetadatos, getMensualPorAseguradora, getDashboardMensual, parseFiltros, METADATOS_VACIOS } from '../lib/query';
import { KPI_COLORS, type KpiKey } from '../lib/kpi-colors';

const f = { ...filtrosPorDefecto(), ...parseFiltros(Astro.url) };
const claveFiltros = JSON.stringify(f);

const metadatos = await cargaSSR('global/metadatos', getMetadatos(f), METADATOS_VACIOS, 300_000);
const tablaMes: any[] = await cargaSSR(`mensual/${claveFiltros}`, getDashboardMensual(f), []);
const mensual: any[] = await cargaSSR(`mensual-aseguradora/${claveFiltros}`, getMensualPorAseguradora(f), []);
const fmt = new Intl.NumberFormat('es-CO');

const selMes = f.mes ?? '';
const selGas = (f.gasera ?? [])[0] ?? '';
const selCabina = (f.cabina ?? [])[0] ?? '';
const selEstado = (f.estado ?? [])[0] ?? '';
const gaseras = metadatos.gaseras ?? [];
const cabinas = metadatos.cabinas ?? [];
const estados = metadatos.estados ?? [];
const mesesFiltro = (metadatos.meses ?? []).filter((m) => m !== 'SIN DATO');
const totalBase = metadatos.total ?? 0;

// --- Arma matriz mes x aseguradora para el gráfico (aseguradoras como columnas) ---
const ORDEN_MES = ['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE'];
const ASEGS = ['ALFA','HDI','SURA','GNP','PROEXEQUIAL','IKE','OTRAS','SIN DATO'];
const COLORES: Record<string,string> = {
  ALFA: 'linear-gradient(180deg,#120180,#3d22c8)',
  HDI: 'linear-gradient(180deg,#00cd93,#5ae280)',
  SURA: 'linear-gradient(180deg,#8b7bff,#b8c0ff)',
  GNP: 'linear-gradient(180deg,#1e40af,#60a5fa)',
  PROEXEQUIAL: 'linear-gradient(180deg,#0ea5e9,#7dd3fc)',
  IKE: 'linear-gradient(180deg,#ec4899,#f9a8d4)',
  OTRAS: 'linear-gradient(180deg,#64748b,#cbd5e1)',
  'SIN DATO': 'linear-gradient(180deg,#334155,#64748b)',
};
const mapaMensual: Record<string, Record<string, number>> = {};
for (const r of mensual) {
  if (!r?.mes) continue;
  const mesMap = mapaMensual[r.mes] ?? (mapaMensual[r.mes] = {});
  mesMap[r.aseguradora] = Number(r.total ?? 0);
}
const mesesChart = ORDEN_MES.filter((m) => mapaMensual[m]);
const maxBar = Math.max(1, ...mensual.map((r: any) => Number(r.total ?? 0)));
const totalesAseg = ASEGS.map((a) => ({ a, total: mensual.filter((r: any) => r.aseguradora === a).reduce((s: number, r: any) => s + Number(r.total ?? 0), 0) })).filter((x) => x.total > 0);
// Alturas precalculadas para el gráfico general (evita expresiones frágiles en el template)
const barrasPorMes: Record<string, { a: string; total: number; h: number; delay: string }[]> = {};
mesesChart.forEach((mes, i) => {
  const mesMap = mapaMensual[mes] ?? {};
  barrasPorMes[mes] = ASEGS.filter((a) => (mesMap[a] ?? 0) > 0).map((a, j) => {
    const total = mesMap[a] ?? 0;
    return { a, total, h: Math.max(6, Math.round((total / maxBar) * 250)), delay: `${(0.1 + i * 0.09 + j * 0.05).toFixed(2)}s` };
  });
});
const totalMes: Record<string, number> = {};
mesesChart.forEach((mes) => {
  const mesMap = mapaMensual[mes] ?? {};
  totalMes[mes] = ASEGS.reduce((s, a) => s + (mesMap[a] ?? 0), 0);
});

const tTot = (k: string) => tablaMes.reduce((s: number, r: any) => s + Number(r[k] ?? 0), 0);
const TT = tTot('total'), TRET = tTot('retenidos'), TAPT = tTot('aptos');
const TPCT = TAPT > 0 ? Math.round((TRET / TAPT) * 1000) / 10 : 0;

// Mini KPIs de la vista detalle (mismo cálculo que el dashboard, tarjetas compactas)
const miniMap: Record<KpiKey, { label: string; valor: string }> = {
  total: { label: 'Total llamadas', valor: fmt.format(TT) },
  inbound: { label: 'Inbound', valor: fmt.format(tTot('inbound')) },
  outbound: { label: 'Outbound', valor: fmt.format(tTot('outbound')) },
  aptos: { label: 'Aptos', valor: fmt.format(TAPT) },
  noAptos: { label: 'No aptos', valor: fmt.format(tTot('noAptos')) },
  retenciones: { label: 'Retenciones', valor: fmt.format(TRET) },
  pctRetencion: { label: '% Retención', valor: `${TPCT}%` },
};

const kpiMini = (['total', 'inbound', 'outbound', 'aptos', 'noAptos', 'retenciones', 'pctRetencion'] as KpiKey[]).map((k) => ({
  ...miniMap[k],
  cls: KPI_COLORS[k].miniCls,
}));
---

<SidebarLayout title="Detalle · Gestión Diaria Promigas 2026">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Corte · Enero a Septiembre 2026</p>
      <h1 class="text-2xl font-extrabold md:text-3xl">Detalle de gestión</h1>
    </div>
    <p class="rounded-full bg-tinta/10 px-4 py-1.5 text-xs font-bold">{fmt.format(TT)} registros</p>
  </div>

  <FiltrosPanel
    action="/detalle"
    opciones={{ mes: mesesFiltro, gasera: gaseras, cabina: cabinas, estado: estados }}
    actual={{ mes: selMes, gasera: selGas, cabina: selCabina, estado: selEstado }}
    totalFiltrado={TT}
    totalBase={totalBase}
  />

  <!-- Mini KPIs -->
  <section class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7" aria-label="Indicadores">
    {kpiMini.map((k) => (
      <div class={`kpi-mini ${k.cls}`}>
        <p class="kpi-mini-num">{k.valor}</p>
        <p class="kpi-mini-label">{k.label}</p>
      </div>
    ))}
  </section>

  <!-- Tabla de gestión por mes -->
  <section class="glass mt-4 overflow-x-auto rounded-3xl p-3">
    <h2 class="p-2 text-base font-bold">Tabla de gestión por mes</h2>
    <table class="tbl-mes w-full min-w-[840px] text-left text-xs">
      <thead><tr class="uppercase tracking-wider">
        <th class="th-mes p-3">Mes</th><th class="th-tot p-3 text-right">Total llamadas</th><th class="th-in p-3 text-right">Inbound</th><th class="th-out p-3 text-right">Outbound</th><th class="th-ret p-3 text-right">Retenciones</th><th class="th-ap p-3 text-right">Aptos</th><th class="th-no p-3 text-right">No Aptos</th><th class="th-pct p-3 text-right">% Retención</th>
      </tr></thead>
      <tbody>
        {tablaMes.map((r: any) => (
          <tr>
            <td class="c-mes p-3">{r.mes}</td>
            <td class="c-tot p-3 text-right">{fmt.format(r.total)}</td>
            <td class="c-in p-3 text-right">{fmt.format(r.inbound)}</td>
            <td class="c-out p-3 text-right">{fmt.format(r.outbound)}</td>
            <td class="c-ret p-3 text-right">{fmt.format(r.retenidos)}</td>
            <td class="c-ap p-3 text-right">{fmt.format(r.aptos)}</td>
            <td class="c-no p-3 text-right">{fmt.format(r.noAptos)}</td>
            <td class="c-pct p-3 text-right">{r.pct}%</td>
          </tr>
        ))}
        <tr class="total-row">
          <td class="p-3">TOTAL</td>
          <td class="p-3 text-right">{fmt.format(TT)}</td>
          <td class="p-3 text-right">{fmt.format(tTot('inbound'))}</td>
          <td class="p-3 text-right">{fmt.format(tTot('outbound'))}</td>
          <td class="p-3 text-right">{fmt.format(TRET)}</td>
          <td class="p-3 text-right">{fmt.format(TAPT)}</td>
          <td class="p-3 text-right">{fmt.format(tTot('noAptos'))}</td>
          <td class="p-3 text-right">{TPCT}%</td>
        </tr>
      </tbody>
    </table>
    <p class="p-2 text-[11px] text-tinta/55">% Retención = Retenidos / Aptos × 100 · Aptos/No Aptos de la columna Clasificación · Mes = columna Mes de la base.</p>
  </section>

  <section class="glass mt-4 rounded-3xl p-5 md:p-8">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Tendencia · Enero a Septiembre 2026</p>
        <h2 class="text-lg font-extrabold md:text-xl">Gestión mensual por aseguradora</h2>
      </div>
      <p class="text-xs text-tinta/60">Un solo gráfico general · eje X todos los meses · aseguradoras como columnas</p>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      {totalesAseg.map((t) => (
        <span class="inline-flex items-center gap-2 rounded-full bg-tinta/10 px-3 py-1 text-xs font-bold">
          <span class="inline-block h-3 w-3 rounded" style={`background:${COLORES[t.a]}`}></span>
          {t.a}: {fmt.format(t.total)}
        </span>
      ))}
    </div>
    <div class="gen-chart mt-4 overflow-x-auto">
      <div class="gen-inner">
        <div class="gen-cols">
          {mesesChart.map((mes) => (
            <div class="gen-month">
              <div class="gen-bars">
                {(barrasPorMes[mes] ?? []).map((b) => (
                  <div class="gen-col" title={`${mes} · ${b.a}: ${fmt.format(b.total)}`}>
                    <span class="gen-val">{fmt.format(b.total)}</span>
                    <div class="gen-bar" style={`height:${b.h}px;background:${COLORES[b.a]};animation-delay:${b.delay}`}></div>
                  </div>
                ))}
              </div>
              <span class="gen-total">{fmt.format(totalMes[mes] ?? 0)}</span>
              <span class="gen-mes">{mes.slice(0, 3)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      {ASEGS.filter((a) => totalesAseg.some((t) => t.a === a)).map((a) => (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-tinta/65">
          <span class="inline-block h-2.5 w-2.5 rounded-sm" style={`background:${COLORES[a]}`}></span>{a}
        </span>
      ))}
    </div>
  </section>

  <style>
    .kpi-mini { position: relative; overflow: hidden; border-radius: 1rem; padding: .7rem .8rem; border: 1px solid color-mix(in srgb, currentColor 12%, transparent); background: color-mix(in srgb, Canvas 80%, transparent); backdrop-filter: blur(14px); transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .3s ease; }
    .kpi-mini:hover { transform: translateY(-3px); box-shadow: 0 14px 28px -16px rgba(18,1,128,.55); }
    .kpi-mini::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--mk, var(--color-xuma-azul)); }
    .kpi-mini-num { font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.1; }
    .kpi-mini-label { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; opacity: .6; }
    .mk-azul { --mk: #120180; } .mk-verde { --mk: #00cd93; } .mk-gris-oscuro { --mk: #475569; }
    .mk-teal { --mk: #0d9488; } .mk-gris { --mk: #64748b; } .mk-azul-claro { --mk: #2563eb; } .mk-rosa { --mk: #f43f5e; }
    @keyframes growBar { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @media (prefers-reduced-motion: reduce) { .gen-bar { animation: none !important; transform: none !important; } }
    /* Tabla mensual: cada columna con su color para diferenciarlas */
    .tbl-mes { border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
    .tbl-mes thead th { font-size: 10px; color: color-mix(in srgb, currentColor 62%, transparent); border-bottom: 2px solid color-mix(in srgb, currentColor 14%, transparent); white-space: nowrap; }
    .tbl-mes thead th::before { content: ""; display: inline-block; width: .55rem; height: .55rem; border-radius: 999px; margin-right: .4rem; background: var(--thc, currentColor); box-shadow: 0 2px 8px -2px var(--thc, currentColor); }
    .th-mes { --thc: #120180; } .th-tot { --thc: #3d22c8; } .th-in { --thc: #00cd93; } .th-out { --thc: #475569; }
    .th-ret { --thc: #2563eb; } .th-ap { --thc: #0d9488; } .th-no { --thc: #f43f5e; } .th-pct { --thc: #64748b; }
    .tbl-mes tbody td { border-bottom: 1px solid color-mix(in srgb, currentColor 8%, transparent); transition: background .25s ease; }
    .tbl-mes tbody tr:hover td { background: color-mix(in srgb, currentColor 6%, transparent); }
    .c-mes { font-weight: 800; background: color-mix(in srgb, #120180 7%, transparent); }
    .c-tot { font-weight: 800; background: color-mix(in srgb, #3d22c8 7%, transparent); }
    .c-in { background: color-mix(in srgb, #00cd93 8%, transparent); }
    .c-out { background: color-mix(in srgb, #475569 8%, transparent); }
    .c-ret { font-weight: 700; color: #1d4ed8; background: color-mix(in srgb, #2563eb 10%, transparent); }
    :global(.dark) .c-ret { color: #93c5fd; }
    .c-ap { background: color-mix(in srgb, #0d9488 8%, transparent); }
    .c-no { background: color-mix(in srgb, #f43f5e 10%, transparent); color: #fff; }
    .c-pct { font-weight: 800; background: color-mix(in srgb, #64748b 10%, transparent); }
    .total-row td { font-weight: 800; border-top: 2px solid color-mix(in srgb, currentColor 22%, transparent); }
    /* Gráfico general: más grande y con presencia */
    .gen-inner { min-width: 860px; }
    .gen-cols { display: flex; gap: .7rem; padding-top: .5rem; }
    .gen-month { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .gen-month + .gen-month { border-left: 1px dashed color-mix(in srgb, currentColor 18%, transparent); padding-left: .7rem; }
    .gen-bars { display: flex; align-items: flex-end; justify-content: center; gap: .3rem; height: 300px; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); padding-bottom: 2px; background-image: linear-gradient(color-mix(in srgb, currentColor 9%, transparent) 1px, transparent 1px); background-size: 100% 25%; }
    .gen-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 3px; height: 100%; min-width: 0; }
    .gen-val { font-size: 10px; font-weight: 800; color: color-mix(in srgb, currentColor 65%, transparent); font-variant-numeric: tabular-nums; }
    .gen-bar { width: 100%; max-width: 34px; border-radius: 8px 8px 3px 3px; transform-origin: bottom; transform: scaleY(0); animation: growBar 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; box-shadow: 0 10px 22px -10px rgba(18,1,128,.5); transition: filter .25s ease; }
    .gen-col:hover .gen-bar { filter: brightness(1.12) saturate(1.15); }
    .gen-total { margin-top: .55rem; text-align: center; font-size: .85rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .gen-mes { margin-top: .3rem; text-align: center; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; opacity: .85; background: color-mix(in srgb, currentColor 7%, transparent); border-radius: 999px; padding: .25rem .1rem; }
  </style>
</SidebarLayout>
