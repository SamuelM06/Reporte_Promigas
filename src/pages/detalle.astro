---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import FiltrosPanel from '../components/filtros/FiltrosPanel.astro';
import { cargaSSR, filtrosPorDefecto, getTabla, getMetadatos, getMensualPorAseguradora, getDashboardMensual, parseFiltros, METADATOS_VACIOS } from '../lib/query';

const f = { ...filtrosPorDefecto(), ...parseFiltros(Astro.url) };
const claveFiltros = JSON.stringify(f);
const pageParam = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isFinite(pageParam) && pageParam > 0 ? Math.floor(pageParam) : 1;
const pageSize = 50;

const [pagina, mensual, tablaMes]: [any, any[], any[]] = await Promise.all([
  cargaSSR(`detalle/tabla/${claveFiltros}/${page}`, getTabla(f, page, pageSize), { rows: [], total: 0, page, pageSize }, 15_000),
  cargaSSR(`detalle/mensual-aseguradora/${claveFiltros}`, getMensualPorAseguradora(f), []),
  cargaSSR(`detalle/tabla-mes/${claveFiltros}`, getDashboardMensual(f), []),
]);
const metadatos = await cargaSSR('detalle/metadatos', getMetadatos(f), METADATOS_VACIOS);
const fmt = new Intl.NumberFormat('es-CO');

const selMes = f.mes ?? '';
const selGas = (f.gasera ?? [])[0] ?? '';
const selCabina = (f.cabina ?? [])[0] ?? '';
const selEstado = (f.estado ?? [])[0] ?? '';
const gaseras = metadatos.gaseras ?? [];
const cabinas = metadatos.cabinas ?? [];
const estados = metadatos.estados ?? [];
const mesesFiltro = (metadatos.meses ?? []).filter((m) => m !== 'SIN DATO');
const totalBase = metadatos.total ?? 0;

const totalPages = Math.max(1, Math.ceil((pagina.total ?? 0) / pageSize));
const pageSafe = Math.min(page, totalPages);

// --- Arma matriz mes x aseguradora para el gráfico (aseguradoras como columnas) ---
const ORDEN_MES = ['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE'];
const ASEGS = ['ALFA','HDI','SURA','GNP','PROEXEQUIAL','IKE','OTRAS','SIN DATO'];
const COLORES: Record<string,string> = {
  ALFA: 'linear-gradient(180deg,#120180,#3d22c8)',
  HDI: 'linear-gradient(180deg,#00cd93,#5ae280)',
  SURA: 'linear-gradient(180deg,#8b7bff,#b8c0ff)',
  GNP: 'linear-gradient(180deg,#f59e0b,#fcd34d)',
  PROEXEQUIAL: 'linear-gradient(180deg,#0ea5e9,#7dd3fc)',
  IKE: 'linear-gradient(180deg,#ec4899,#f9a8d4)',
  OTRAS: 'linear-gradient(180deg,#64748b,#cbd5e1)',
  'SIN DATO': 'linear-gradient(180deg,#334155,#64748b)',
};
const mapaMensual: Record<string, Record<string, number>> = {};
for (const r of mensual) {
  if (!r?.mes) continue;
  mapaMensual[r.mes] = mapaMensual[r.mes] ?? {};
  mapaMensual[r.mes][r.aseguradora] = Number(r.total ?? 0);
}
const mesesChart = ORDEN_MES.filter((m) => mapaMensual[m]);
const maxBar = Math.max(1, ...mensual.map((r: any) => Number(r.total ?? 0)));
const totalesAseg = ASEGS.map((a) => ({ a, total: mensual.filter((r: any) => r.aseguradora === a).reduce((s: number, r: any) => s + Number(r.total ?? 0), 0) })).filter((x) => x.total > 0);
// Alturas precalculadas para el gráfico general (evita expresiones frágiles en el template)
const barrasPorMes: Record<string, { a: string; total: number; h: number; delay: string }[]> = {};
mesesChart.forEach((mes, i) => {
  barrasPorMes[mes] = ASEGS.filter((a) => (mapaMensual[mes]?.[a] ?? 0) > 0).map((a, j) => {
    const total = mapaMensual[mes][a] ?? 0;
    return { a, total, h: Math.max(5, Math.round((total / maxBar) * 170)), delay: `${(0.1 + i * 0.09 + j * 0.05).toFixed(2)}s` };
  });
});

const prevBase = new URLSearchParams(Astro.url.searchParams);
prevBase.delete('page');
const qsSinPage = prevBase.toString();
const hrefPag = (p: number) => `/detalle?${qsSinPage ? qsSinPage + '&' : ''}page=${p}`;
const prevHref = pageSafe > 1 ? hrefPag(pageSafe - 1) : null;
const nextHref = pageSafe < totalPages ? hrefPag(pageSafe + 1) : null;

const tTot = (k: string) => tablaMes.reduce((s: number, r: any) => s + Number(r[k] ?? 0), 0);
const TT = tTot('total'), TRET = tTot('retenidos'), TAPT = tTot('aptos');
const TPCT = TAPT > 0 ? Math.round((TRET / TAPT) * 1000) / 10 : 0;

// Mini KPIs de la vista detalle (mismo cálculo que el dashboard, tarjetas compactas)
const kpiMini = [
  { label: 'Total llamadas', valor: fmt.format(TT), cls: 'mk-azul' },
  { label: 'Inbound', valor: fmt.format(tTot('inbound')), cls: 'mk-verde' },
  { label: 'Outbound', valor: fmt.format(tTot('outbound')), cls: 'mk-violeta' },
  { label: 'Aptos', valor: fmt.format(TAPT), cls: 'mk-teal' },
  { label: 'No aptos', valor: fmt.format(tTot('noAptos')), cls: 'mk-gris' },
  { label: 'Retenciones', valor: fmt.format(TRET), cls: 'mk-ambar' },
  { label: '% Retención', valor: `${TPCT}%`, cls: 'mk-rosa' },
];
---

<SidebarLayout title="Detalle · Gestión Diaria Promigas 2026">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Corte · Enero a Septiembre 2026 · Página 2 · {pageSafe} de {fmt.format(totalPages)}</p>
      <h1 class="text-2xl font-extrabold md:text-3xl">Detalle de gestión</h1>
    </div>
    <p class="rounded-full bg-tinta/10 px-4 py-1.5 text-xs font-bold">{fmt.format(pagina.total)} registros</p>
  </div>

  <FiltrosPanel
    action="/detalle"
    opciones={{ mes: mesesFiltro, gasera: gaseras, cabina: cabinas, estado: estados }}
    actual={{ mes: selMes, gasera: selGas, cabina: selCabina, estado: selEstado }}
    totalFiltrado={pagina.total}
    totalBase={totalBase}
  />

  <!-- Mini KPIs -->
  <section class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7" aria-label="Indicadores">
    {kpiMini.map((k) => (
      <div class={`kpi-mini ${k.cls}`}>
        <p class="kpi-mini-num">{k.valor}</p>
        <p class="kpi-mini-label">{k.label}</p>
      </div>
    ))}
  </section>

  <!-- Página 2: tabla de gestión por mes -->
  <section class="glass mt-4 overflow-x-auto rounded-3xl p-3">
    <h2 class="p-2 text-base font-bold">Tabla de gestión por mes</h2>
    <table class="w-full min-w-[760px] text-left text-xs">
      <thead><tr class="uppercase tracking-wider text-tinta/55">
        <th class="p-3">Mes</th><th class="p-3 text-right">Total llamadas</th><th class="p-3 text-right">Inbound</th><th class="p-3 text-right">Outbound</th><th class="p-3 text-right">Retenciones</th><th class="p-3 text-right">Aptos</th><th class="p-3 text-right">No Aptos</th><th class="p-3 text-right">% Retención</th>
      </tr></thead>
      <tbody>
        {tablaMes.map((r: any) => (
          <tr class="border-t border-tinta/10 hover:bg-tinta/5">
            <td class="p-3 font-extrabold">{r.mes}</td>
            <td class="p-3 text-right">{fmt.format(r.total)}</td>
            <td class="p-3 text-right">{fmt.format(r.inbound)}</td>
            <td class="p-3 text-right">{fmt.format(r.outbound)}</td>
            <td class="p-3 text-right font-bold text-amber-600">{fmt.format(r.retenidos)}</td>
            <td class="p-3 text-right">{fmt.format(r.aptos)}</td>
            <td class="p-3 text-right">{fmt.format(r.noAptos)}</td>
            <td class="p-3 text-right font-extrabold text-xuma-verde-oscuro">{r.pct}%</td>
          </tr>
        ))}
        <tr class="border-t-2 border-tinta/20 font-extrabold">
          <td class="p-3">TOTAL</td>
          <td class="p-3 text-right">{fmt.format(TT)}</td>
          <td class="p-3 text-right">{fmt.format(tTot('inbound'))}</td>
          <td class="p-3 text-right">{fmt.format(tTot('outbound'))}</td>
          <td class="p-3 text-right">{fmt.format(TRET)}</td>
          <td class="p-3 text-right">{fmt.format(TAPT)}</td>
          <td class="p-3 text-right">{fmt.format(tTot('noAptos'))}</td>
          <td class="p-3 text-right">{TPCT}%</td>
        </tr>
      </tbody>
    </table>
    <p class="p-2 text-[11px] text-tinta/55">% Retención = Retenidos / Aptos × 100 · Aptos/No Aptos de la columna Clasificación · Mes = columna Mes de la base.</p>
  </section>

  <section class="glass mt-4 rounded-3xl p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-base font-bold">Gestión mensual por aseguradora</h2>
      <p class="text-xs text-tinta/60">Un solo gráfico general · eje X todos los meses · aseguradoras como columnas</p>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      {totalesAseg.map((t) => (
        <span class="inline-flex items-center gap-2 rounded-full bg-tinta/10 px-3 py-1 text-xs font-bold">
          <span class="inline-block h-3 w-3 rounded" style={`background:${COLORES[t.a]}`}></span>
          {t.a}: {fmt.format(t.total)}
        </span>
      ))}
    </div>
    <div class="gen-chart mt-2 overflow-x-auto">
      <div class="gen-inner">
        <div class="gen-cols">
          {mesesChart.map((mes) => (
            <div class="gen-month">
              <div class="gen-bars">
                {(barrasPorMes[mes] ?? []).map((b) => (
                  <div class="gen-col" title={`${mes} · ${b.a}: ${fmt.format(b.total)}`}>
                    <span class="gen-val">{fmt.format(b.total)}</span>
                    <div class="gen-bar" style={`height:${b.h}px;background:${COLORES[b.a]};animation-delay:${b.delay}`}></div>
                  </div>
                ))}
              </div>
              <span class="gen-mes">{mes.slice(0, 3)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      {ASEGS.filter((a) => totalesAseg.some((t) => t.a === a)).map((a) => (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-tinta/65">
          <span class="inline-block h-2.5 w-2.5 rounded-sm" style={`background:${COLORES[a]}`}></span>{a}
        </span>
      ))}
    </div>
  </section>

  <style>
    .kpi-mini { position: relative; overflow: hidden; border-radius: 1rem; padding: .7rem .8rem; border: 1px solid color-mix(in srgb, currentColor 12%, transparent); background: color-mix(in srgb, Canvas 80%, transparent); backdrop-filter: blur(14px); transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .3s ease; }
    .kpi-mini:hover { transform: translateY(-3px); box-shadow: 0 14px 28px -16px rgba(18,1,128,.55); }
    .kpi-mini::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--mk, var(--color-xuma-azul)); }
    .kpi-mini-num { font-size: 1.15rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.1; }
    .kpi-mini-label { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; opacity: .6; }
    .mk-azul { --mk: #120180; } .mk-verde { --mk: #00cd93; } .mk-violeta { --mk: #8b7bff; }
    .mk-teal { --mk: #0d9488; } .mk-gris { --mk: #64748b; } .mk-ambar { --mk: #f59e0b; } .mk-rosa { --mk: #f43f5e; }
    @keyframes growBar { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @media (prefers-reduced-motion: reduce) { .gen-bar { animation: none !important; transform: none !important; } }
    .gen-inner { min-width: 720px; }
    .gen-cols { display: flex; gap: .7rem; padding-top: .5rem; }
    .gen-month { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .gen-month + .gen-month { border-left: 1px dashed color-mix(in srgb, currentColor 18%, transparent); padding-left: .7rem; }
    .gen-bars { display: flex; align-items: flex-end; justify-content: center; gap: .3rem; height: 210px; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); padding-bottom: 2px; }
    .gen-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 3px; height: 100%; min-width: 0; }
    .gen-val { font-size: 9px; font-weight: 800; color: color-mix(in srgb, currentColor 65%, transparent); font-variant-numeric: tabular-nums; }
    .gen-bar { width: 100%; max-width: 24px; border-radius: 6px 6px 2px 2px; transform-origin: bottom; transform: scaleY(0); animation: growBar 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; box-shadow: 0 8px 18px -10px rgba(18,1,128,.5); }
    .gen-mes { margin-top: .45rem; text-align: center; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; opacity: .85; background: color-mix(in srgb, currentColor 7%, transparent); border-radius: 999px; padding: .2rem .1rem; }
  </style>

  <section class="glass mt-4 overflow-x-auto rounded-3xl p-3">
    <table class="w-full min-w-[900px] text-left text-xs">
      <thead><tr class="uppercase tracking-wider text-tinta/55">
        <th class="p-3">Contrato</th><th class="p-3">Gasera</th><th class="p-3">Aseguradora</th><th class="p-3">Canal</th><th class="p-3">Producto</th><th class="p-3">Estado</th><th class="p-3">Clasificación</th><th class="p-3">Fecha</th><th class="p-3">Mes</th><th class="p-3">Cabina</th>
      </tr></thead>
      <tbody>
        {pagina.rows.map((r: any) => (
          <tr class="border-t border-tinta/10 hover:bg-tinta/5">
            <td class="p-3 font-bold">{r.contrato ?? '—'}</td><td class="p-3">{r.gasera ?? '—'}</td><td class="p-3">{r.aseguradora ?? '—'}</td><td class="p-3">{r.canal ?? '—'}</td><td class="p-3">{r.producto ?? '—'}</td><td class="p-3">{r.estado ?? '—'}</td><td class="p-3 font-semibold">{r.clasificacion ?? '—'}</td><td class="p-3">{r.fecha_ejecucion ?? '—'}</td><td class="p-3">{r.mes ?? '—'}</td><td class="p-3">{r.cabina ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="flex flex-wrap items-center justify-between gap-3 p-3">
      <p class="text-xs text-tinta/60">Mostrando {pagina.rows.length} de {fmt.format(pagina.total)} · página {pageSafe}/{fmt.format(totalPages)}</p>
      <div class="flex gap-2">
        {prevHref ? <a href={prevHref} class="glass glass-hover rounded-xl px-4 py-2 text-xs font-bold">← Anterior</a> : <span class="rounded-xl bg-tinta/5 px-4 py-2 text-xs opacity-50">← Anterior</span>}
        {nextHref ? <a href={nextHref} class="glass glass-hover rounded-xl px-4 py-2 text-xs font-bold">Siguiente →</a> : <span class="rounded-xl bg-tinta/5 px-4 py-2 text-xs opacity-50">Siguiente →</span>}
      </div>
    </div>
  </section>
</SidebarLayout>
