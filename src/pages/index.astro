---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { cargaSSR, filtrosPorDefecto, getMetadatos, METADATOS_VACIOS } from '../lib/query';

const f = filtrosPorDefecto();
let metadatos = METADATOS_VACIOS;
try {
  metadatos = await cargaSSR('inicio/metadatos', getMetadatos(f), METADATOS_VACIOS);
} catch { metadatos = METADATOS_VACIOS; }
const total = metadatos?.total ?? 0;
const fmt = new Intl.NumberFormat('es-CO');

const paginas = [
  {
    href: '/dashboard',
    titulo: 'Dashboard',
    desc: 'KPIs, tendencias y gestión mensual por aseguradora',
    tag: 'Página 1',
  },
  {
    href: '/detalle',
    titulo: 'Detalle',
    desc: 'Tabla de gestión con paginación y gráfico mensual',
    tag: 'Página 2',
  },
];
---

<SidebarLayout title="Inicio · Gestión Diaria Promigas 2026">
  <div class="flex min-h-[calc(100dvh-6rem)] flex-col gap-6">
    <!-- Header bonito del reporte -->
    <header class="show fade-up relative overflow-hidden rounded-3xl border border-xuma-violeta/25 bg-gradient-to-r from-xuma-azul via-xuma-azul-2 to-xuma-verde-oscuro p-6 text-white md:p-8 dark:from-[#0a1030] dark:via-xuma-azul dark:to-xuma-verde-oscuro" style="animation-delay:0.02s">
      <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-xuma-verde-claro/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-xuma-violeta/30 blur-3xl"></div>
      <p class="relative text-xs font-bold uppercase tracking-[0.2em] text-white/70">Inicio · Gestión Diaria Promigas</p>
      <h1 class="relative mt-2 text-2xl font-extrabold leading-tight md:text-4xl">
        Gestión Diaria <span class="texto-brillo">Promigas</span> 2026
      </h1>
      <p class="relative mt-1 text-sm font-semibold text-white/80">Corte · Enero a Septiembre 2026</p>
      <div class="relative mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-xs font-bold backdrop-blur">
          <span class="h-2 w-2 animate-pulse rounded-full bg-xuma-verde-claro"></span>
          Corte · Enero a Septiembre 2026
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-xs font-bold backdrop-blur">
          {fmt.format(total)} registros en base
        </span>
      </div>
    </header>

    <section class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="show fade-up" style="animation-delay:0.08s">
        <h2 class="text-xl font-extrabold md:text-2xl">
          Acumulado <span class="texto-brillo">a septiembre</span>
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-tinta/65 md:text-base">
          Portal de la gestión diaria de <strong class="text-tinta">Promigas 2026</strong>:
          distribuidoras, aseguradoras, canales, productos y estados
          <strong class="text-tinta"> hasta septiembre</strong>, con la identidad
          visual de Xuma. Pasa el mouse por el borde izquierdo para abrir el menú lateral.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="/dashboard" class="group inline-flex h-12 items-center gap-2 rounded-2xl bg-xuma-azul px-6 font-bold text-white shadow-lg shadow-xuma-azul/20 transition-all duration-300 hover:scale-105 hover:bg-xuma-azul-2 dark:bg-xuma-verde-claro dark:text-[#0a1030] dark:hover:bg-xuma-verde-oscuro">
            Ver tablero <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a href="/detalle" class="glass glass-hover inline-flex h-12 items-center gap-2 rounded-2xl px-5 font-semibold text-tinta">
            Ver detalle
          </a>
        </div>
      </div>
      <div class="hidden justify-center lg:flex">
        <div class="show scale-in relative" style="animation-delay:0.2s">
          <img src="/logos/Transparente_Logo_azul_letra_azul.svg" alt="Xuma" class="w-56 opacity-90 drop-shadow-[0_0_60px_rgba(18,1,128,0.25)] md:w-64 dark:hidden" />
          <img src="/logos/Transparente_Logo_blanco_letra_blanca.svg" alt="Xuma" class="hidden w-56 opacity-90 drop-shadow-[0_0_60px_rgba(90,226,128,0.35)] md:w-64 dark:block" />
        </div>
      </div>
    </section>

    <!-- Páginas del reporte: lista lateral animada -->
    <section class="glass rounded-3xl p-5 md:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-tinta">Páginas del reporte</h2>
        <p class="text-xs text-tinta/60">Navegación del portal</p>
      </div>
      <nav class="mt-4 flex flex-col gap-3" aria-label="Páginas del reporte">
        {paginas.map((p, i) => (
          <a href={p.href} class="page-row show slide-lateral group" style={`animation-delay:${0.1 + i * 0.15}s`}>
            <span class="page-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="page-body">
              <span class="page-title">{p.titulo} <span class="page-tag">{p.tag}</span></span>
              <span class="page-desc">{p.desc}</span>
            </span>
            <span class="page-go">→</span>
          </a>
        ))}
      </nav>
    </section>

    <section class="glass rounded-3xl p-5 md:p-6">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <h2 class="text-lg font-bold text-tinta">¿Cómo leer este reporte?</h2>
          <p class="mt-2 text-xs leading-relaxed text-tinta/65 md:text-sm">
            Los datos viven en <code class="rounded-md bg-tinta/10 px-2 py-0.5">DataCenter_Promigas · reportes.reporte_promi</code>.
            El corte cubre de enero a septiembre de 2026 por fecha de ejecución. Usa el menú lateral
            (se abre con el mouse y se esconde solo al cambiar de página) para navegar.
          </p>
        </div>
        <a href="/dashboard" class="glass glass-hover inline-flex h-11 items-center gap-2 rounded-2xl px-5 text-sm font-semibold text-tinta">Ir al dashboard</a>
      </div>
    </section>
  </div>

  <style>
    .show { opacity: 0; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    @keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
    @keyframes slideLateral { from { opacity: 0; transform: translateX(-42px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .show { opacity: 1; } }
    .fade-up { animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .scale-in { animation: scaleIn 1s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .slide-lateral { animation: slideLateral 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .page-row {
      display: flex; align-items: center; gap: 1rem;
      padding: 1rem 1.1rem; border-radius: 1.25rem;
      border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
      background: color-mix(in srgb, currentColor 4%, transparent);
      transition: transform .35s cubic-bezier(0.22, 1, 0.36, 1), background .3s ease, box-shadow .3s ease;
    }
    .page-row:hover { transform: translateX(10px); box-shadow: 0 18px 40px -22px rgba(18,1,128,.55); }
    .page-num {
      display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 1rem;
      font-weight: 800; color: #fff; flex-shrink: 0;
      background: linear-gradient(135deg, var(--color-xuma-azul), var(--color-xuma-verde-oscuro));
    }
    .page-body { display: flex; flex-direction: column; flex: 1; line-height: 1.3; }
    .page-title { font-weight: 800; font-size: 1rem; display: flex; align-items: center; gap: .6rem; }
    .page-tag { font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; opacity: .55; border: 1px dashed currentColor; border-radius: 999px; padding: .2rem .6rem; }
    .page-desc { font-size: .78rem; opacity: .6; }
    .page-go { font-weight: 800; opacity: 0; transform: translateX(-8px); transition: all .3s ease; }
    .page-row:hover .page-go { opacity: 1; transform: none; }
  </style>
</SidebarLayout>
