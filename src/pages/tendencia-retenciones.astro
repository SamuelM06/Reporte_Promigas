---
// Página: Tendencia de retenciones.
// Tendencia mensual de retenciones + dona de participación por resultado.
// Todos los datos vienen de la capa de consulta (query.ts); el componente solo pinta.
import { ruta } from '../lib/base';
import SidebarLayout from '../layouts/SidebarLayout.astro';
import FiltrosGlobales from '../components/filtros/FiltrosGlobales.astro';
import { cargaSSR, filtrosPorDefecto, getRetenidosPorMes, getResultadosRetencion, getMetadatos, METADATOS_VACIOS, parseFiltros } from '../lib/query';
import { fmtInt, fmtPct, pct } from '../lib/util';

const f = { ...filtrosPorDefecto(), ...parseFiltros(Astro.url) };
const claveFiltros = JSON.stringify(f);

const metadatos = await cargaSSR(`tendencia/metadatos/${claveFiltros}`, getMetadatos(f), METADATOS_VACIOS, 300_000);
const tendencia: { periodo: string; retenidos: number }[] = await cargaSSR(`tendencia/mes/${claveFiltros}`, getRetenidosPorMes(f), []);
const res: { retenido: number; canceladoVenta: number; total: number } = await cargaSSR(`tendencia/resultados/${claveFiltros}`, getResultadosRetencion(f), { retenido: 0, canceladoVenta: 0, total: 0 });

const selMes = f.mes ?? [];
const selGas = f.gasera ?? [];
const selAseg = f.aseguradora ?? [];
const selCabina = f.cabina ?? [];
const selEstado = f.estado ?? [];
const selClasif = f.clasificacion ?? [];
const gaseras = metadatos.gaseras ?? [];
const aseguradoras = metadatos.aseguradoras ?? [];
const cabinas = metadatos.cabinas ?? [];
const estados = metadatos.estados ?? [];
const clasificaciones = metadatos.clasificaciones ?? [];
const mesesFiltro = (metadatos.meses ?? []).filter((m) => m !== 'SIN DATO');
const totalBase = metadatos.total ?? 0;

const mesesDisponibles = (metadatos.meses ?? []).filter(m => m !== 'SIN DATO');
const corteTexto = mesesDisponibles.length > 0
  ? `Corte · ${mesesDisponibles[0]} a ${mesesDisponibles[mesesDisponibles.length - 1]} 2026`
  : 'Corte · Enero a Diciembre 2026';

// --- Cálculos de tarjetas resumen ---
const totalRet = res.total;
const mejorMes: { periodo: string; retenidos: number } = tendencia.length > 0
  ? tendencia.reduce((a: { periodo: string; retenidos: number }, b: { periodo: string; retenidos: number }) => (b.retenidos > a.retenidos ? b : a), tendencia[0] ?? { periodo: '-', retenidos: 0 })
  : { periodo: '-', retenidos: 0 };
const promedioMensual = tendencia.length > 0
  ? Math.round(totalRet / tendencia.length)
  : 0;

// --- Geometría del gráfico de línea/área ---
const H = 220;
const n = Math.max(1, tendencia.length);
const stepX = 100 / n;
const maxR = Math.max(1, ...tendencia.map((r) => r.retenidos));
const px = (i: number) => (stepX * i + stepX / 2).toFixed(2);
const py = (v: number) => (H - 30 - (v / maxR) * (H - 70)).toFixed(1);
const linePts = tendencia.map((r, i) => `${px(i)},${py(r.retenidos)}`).join(' ');
const areaPts = `${linePts} 100,${H} 0,${H}`;

// Índices de máximo y mínimo (para resaltar etiquetas)
let idxMax = 0, idxMin = 0;
for (let i = 1; i < tendencia.length; i++) {
  if (tendencia[i]!.retenidos > tendencia[idxMax]!.retenidos) idxMax = i;
  if (tendencia[i]!.retenidos < tendencia[idxMin]!.retenidos) idxMin = i;
}

const cabinaLabel = selCabina.length === 1 ? selCabina[0] : 'Todas las cabinas';
const tituloGrafico = `Retenciones por mes · ${cabinaLabel}`;
---

<SidebarLayout title="Tendencia de Retenciones · Promigas 2026" corteTexto={corteTexto}>
  <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">{corteTexto}</p>
      <h1 class="flex items-center gap-2 text-2xl font-extrabold md:text-3xl">
        <span class="kpi-ico" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V3"/><path d="M5 12h14"/><path d="M12 3l7 7-7 7"/></svg>' /> Tendencia de <span class="texto-brillo">Retenciones</span>
      </h1>
    </div>
  </div>

  <FiltrosGlobales
    action={ruta('/tendencia-retenciones')}
    opciones={{ mes: mesesFiltro, gasera: gaseras, aseguradora: aseguradoras, cabina: cabinas, estado: estados, clasificacion: clasificaciones }}
    actual={{ mes: selMes, gasera: selGas, aseguradora: selAseg, cabina: selCabina, estado: selEstado, clasificacion: selClasif }}
    totalFiltrado={totalRet}
    totalBase={totalBase}
  />

  <!-- Tarjetas resumen -->
  <section class="mt-3 grid gap-2.5 sm:grid-cols-3 lg:grid-cols-3">
    <article class="kpi-card kpi-azul fade-up" style="animation-delay:0.1s">
      <span class="kpi-glow" aria-hidden="true"></span>
      <span class="kpi-ico kpi-ico-sm" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>' />
      <span class="kpi-body">
        <span class="kpi-label">Total retenciones</span>
        <span class="kpi-num text-blue-700 dark:text-blue-300" data-count={res.total}>{fmtInt(res.total)}</span>
        <span class="kpi-nota">del corte seleccionado</span>
      </span>
    </article>
    <article class="kpi-card kpi-verde fade-up" style="animation-delay:0.2s">
      <span class="kpi-glow" aria-hidden="true"></span>
      <span class="kpi-ico kpi-ico-sm" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 10V3L4 14h7v7l9-11h-9z"/></svg>' />
      <span class="kpi-body">
        <span class="kpi-label">Mejor mes</span>
        <span class="kpi-num text-green-600 dark:text-green-400" data-count={mejorMes.retenidos}>{fmtInt(mejorMes.retenidos)}</span>
        <span class="kpi-nota">{mejorMes.periodo}</span>
      </span>
    </article>
    <article class="kpi-card kpi-teal fade-up" style="animation-delay:0.3s">
      <span class="kpi-glow" aria-hidden="true"></span>
      <span class="kpi-ico kpi-ico-sm" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19V6h12v13"/><path d="M16 15h4"/><path d="M10 11h6"/></svg>' />
      <span class="kpi-body">
        <span class="kpi-label">Promedio mensual</span>
        <span class="kpi-num text-teal-600 dark:text-teal-400" data-count={promedioMensual}>{fmtInt(promedioMensual)}</span>
        <span class="kpi-nota">por mes con datos</span>
      </span>
    </article>
  </section>

  <section class="mt-3 grid gap-3 lg:grid-cols-12">
    <!-- Tendencia (ancho completo) -->
    <div class="glass rounded-3xl p-4 md:p-5 lg:col-span-9 flex flex-col">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <h2 class="flex items-center gap-2 text-base font-bold md:text-lg">
          <span class="kpi-ico kpi-ico-sm" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M7 20v-8"/><path d="M12 20v-12"/><path d="M17 20v-5"/></svg>' /> {tituloGrafico}
        </h2>
        <p class="text-xs text-tinta/60">{tendencia.length} mes{(tendencia.length !== 1 ? 's' : '')} con datos</p>
      </div>

      {tendencia.length === 0 ? (
        <p class="mt-6 text-sm text-tinta/60">Sin datos para los filtros seleccionados.</p>
      ) : (
        <div class="chart-wrap mt-2 flex-1 min-h-[260px]">
          <svg class="trend-svg" viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" aria-label="Tendencia de retenciones por mes">
            <!-- Área degradada -->
            <defs>
              <linearGradient id="gradArea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#1e40af" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#1e40af" stop-opacity="0.05" />
              </linearGradient>
            </defs>
            <path d={`M${areaPts}`} fill="url(#gradArea)" />
            <!-- Línea -->
            <polyline points={linePts} fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <animate attributeName="stroke-dashoffset" from="600" to="0" dur="1.2s" fill="freeze" />
            </polyline>
            <!-- Puntos -->
            {tendencia.map((r, i) => {
              const esMax = i === idxMax;
              const esMin = i === idxMin;
              const esDestacado = esMax || esMin;
              return (
                <circle
                  class="trend-dot"
                  cx={px(i)}
                  cy={py(r.retenidos)}
                  r={esDestacado ? 5 : 3}
                  fill="#2563eb"
                  stroke="#ffffff"
                  stroke-width={esDestacado ? 2 : 1}
                />
              );
            })}
          </svg>

          <!-- Eje X con etiquetas de mes -->
          <div class="trend-axis mt-3 flex justify-between text-[10px] font-bold uppercase tracking-wider opacity-75">
            {tendencia.map((r) => (
              <span style="text-align:center;flex:1">{String(r.periodo).slice(0, 6)}</span>
            ))}
          </div>

          <!-- Etiquetas máximo/mínimo -->
          <div class="trend-labels mt-2 flex justify-between gap-2 text-xs font-bold">
            {tendencia.length > 0 && (
              <>
                <span class="trend-label-max" style="text-align:center;flex:1;color:#059669">
                  ▲ {fmtInt(tendencia[idxMax]?.retenidos ?? 0)} · {tendencia[idxMax]?.periodo ?? '-'}
                </span>
                <span class="trend-label-min" style="text-align:center;flex:1;color:#dc2626">
                  ▼ {fmtInt(tendencia[idxMin]?.retenidos ?? 0)} · {tendencia[idxMin]?.periodo ?? '-'}
                </span>
              </>
            )}
          </div>
        </div>
      )}

      <p class="mt-3 text-[11px] leading-relaxed text-tinta/55">
        Fórmula: <strong>Retenidos = RETENIDO + CANCELADO + VENTA</strong> (según estado de gestión). Serie muestra el total de retenciones por mes.
      </p>
    </div>

    <!-- Dona de participación (columna más angosta) -->
    <div class="lg:col-span-3 flex flex-col gap-3">
      <div class="glass rounded-3xl p-4 md:p-5 flex-1 flex flex-col">
        <h2 class="flex items-center gap-2 text-base font-bold md:text-lg mb-3">
          <span class="kpi-ico kpi-ico-sm" set:html='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>' /> Participación por resultado
        </h2>
        <div class="flex-1 flex flex-col items-center justify-center relative min-h-[240px]">
          <svg class="donut-svg w-full max-w-[260px] max-h-[260px] viewbox-square" viewBox="0 0 200 200">
            <defs>
              {res.total > 0 ? (
                <>
                  <linearGradient id="gradRet" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#059669" />
                    <stop offset="100%" stop-color="#34d399" />
                  </linearGradient>
                  <linearGradient id="gradCv" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#dc2626" />
                    <stop offset="100%" stop-color="#f87171" />
                  </linearGradient>
                </>
              ) : null}
            </defs>
            <!-- Fondo de dona (carril) -->
            {res.total > 0 ? (
              <>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#e2e8f0" stroke-width="16" stroke-linecap="round" />
                <circle cx="100" cy="100" r="80" fill="none" stroke="url(#gradRet)" stroke-width="16" stroke-linecap="round">
                  <animate attributeName="stroke-dasharray" from="0" to={`${pct(res.retenido, res.total) * 5.024}`} dur="1s" fill="freeze" />
                  <animate attributeName="stroke-dashoffset" from="502.4" to="0" dur="1s" fill="freeze" />
                </circle>
                <circle cx="100" cy="100" r="80" fill="none" stroke="url(#gradCv)" stroke-width="16" stroke-linecap="round" transform="rotate(-90 100 100)">
                  <animate attributeName="stroke-dasharray" from="0" to={`${pct(res.canceladoVenta, res.total) * 5.024}`} dur="1s" fill="freeze" />
                  <animate attributeName="stroke-dashoffset" from="502.4" to="0" dur="1s" fill="freeze" />
                </circle>
              </>
            ) : (
              <circle cx="100" cy="100" r="80" fill="none" stroke="#cbd5e1" stroke-width="16" stroke-linecap="round" />
            )}
            <!-- Centro: total + etiqueta -->
            <text x="100" y="100" text-anchor="middle" dy=".35em" fill="#10142e" font-weight="800" font-size="22">{fmtInt(res.total)}</text>
            <text x="100" y="122" text-anchor="middle" dy=".35em" fill="#64748b" font-weight="700" font-size="12">Retenciones</text>
          </svg>
        </div>

        <!-- Leyenda -->
        <div class="mt-3 flex flex-wrap gap-3 text-sm">
          <span class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full" style="background:#059669"></span>
            <span>Retenido {fmtInt(res.retenido)} · {fmtPct(pct(res.retenido, res.total))}</span>
          </span>
          <span class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full" style="background:#dc2626"></span>
            <span>Cancelado + Venta {fmtInt(res.canceladoVenta)} · {fmtPct(pct(res.canceladoVenta, res.total))}</span>
          </span>
          {res.total > 0 && (
            <span class="flex items-center gap-2 opacity-60">
              <span>Total {fmtInt(res.total)}</span>
            </span>
          )}
        </div>
        {res.total === 0 && (
          <p class="mt-4 text-sm text-tinta/60 text-center">Sin datos para los filtros seleccionados.</p>
        )}
      </div>
    </div>
  </section>

  <style>
    .trend-svg { width: 100%; height: 100%; display: block; }
    .trend-dot { cursor: pointer; transition: r 0.2s ease; }
    .trend-dot:hover { r: 6; fill: #3b82f6; }
    .trend-axis { user-select: none; }
    .trend-label-max, .trend-label-min { background: color-mix(in srgb, Canvas 90%, transparent); padding: 2px 6px; border-radius: 6px; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
    .donut-svg { width: 100%; height: auto; display: block; }
    .donut-svg text { font-family: 'Raleway', sans-serif; }
    .kpi-ico-sm { width: 2rem; height: 2rem; border-radius: 0.7rem; }
    .kpi-ico-sm :global(svg) { width: 1rem; height: 1rem; }
    @media (max-width: 1000px) {
      .lg\:col-span-9 { grid-column: 1 / -1; }
      .lg\:col-span-3 { grid-column: 1 / -1; }
    }
  </style>

  <script is:inline>
    // Conteo animado de los KPI numéricos.
    (function () {
      var els = document.querySelectorAll('.kpi-num[data-count]');
      if (!els.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (el) {
          var target = parseFloat(el.getAttribute('data-count') || '0');
          el.textContent = new Intl.NumberFormat('es-CO').format(Math.trunc(target));
        });
        return;
      }
      var fmt = new Intl.NumberFormat('es-CO');
      els.forEach(function (el) {
        var target = parseFloat(el.getAttribute('data-count') || '0');
        var t0 = null, dur = 1000;
        function tick(t) {
          if (!t0) t0 = t;
          var p = Math.min(1, (t - t0) / dur);
          var e = 1 - Math.pow(1 - p, 3);
          var v = target * e;
          el.textContent = fmt.format(Math.trunc(v));
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    })();
  </script>
</SidebarLayout>