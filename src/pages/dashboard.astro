---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import { cargaSSR, filtrosPorDefecto, getKpis, getTendencia, getMetadatos, METADATOS_VACIOS } from '../lib/query';

const f = filtrosPorDefecto();
const KPIS0 = { total: 0, retenidos: 0, cancelados: 0, noContacto: 0, pctRetencion: 0 };
const kpis = await cargaSSR('dashboard/kpis', getKpis(f), KPIS0);
const tendencia: any[] = await cargaSSR('dashboard/tendencia', getTendencia(f), []);
const metadatos = await cargaSSR('dashboard/metadatos', getMetadatos(f), METADATOS_VACIOS);
const fmt = new Intl.NumberFormat('es-CO');
const maxT = Math.max(1, ...tendencia.map((t: any) => Number(t.total ?? 0)));
---

<SidebarLayout title="Dashboard · Gestión Diaria Promigas 2026">
  <div class="mb-4">
    <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Corte · Enero a Diciembre 2026</p>
    <h1 class="text-2xl font-extrabold md:text-3xl">Dashboard de <span class="texto-brillo">Gestión Diaria</span></h1>
  </div>

  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <article class="glass rounded-3xl p-5"><p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Total gestiones</p><p class="mt-1 text-3xl font-extrabold">{fmt.format(kpis.total)}</p></article>
    <article class="glass rounded-3xl p-5"><p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Retenidos</p><p class="mt-1 text-3xl font-extrabold text-xuma-verde-oscuro">{fmt.format(kpis.retenidos)}</p><p class="text-xs text-tinta/60">{kpis.pctRetencion}% retención</p></article>
    <article class="glass rounded-3xl p-5"><p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Cancelados</p><p class="mt-1 text-3xl font-extrabold">{fmt.format(kpis.cancelados)}</p></article>
    <article class="glass rounded-3xl p-5"><p class="text-xs font-bold uppercase tracking-widest text-tinta/55">No contacto</p><p class="mt-1 text-3xl font-extrabold">{fmt.format(kpis.noContacto)}</p></article>
  </section>

  <section class="glass mt-4 rounded-3xl p-5">
    <h2 class="text-base font-bold">Tendencia por mes</h2>
    <div class="mt-4 flex h-44 items-end gap-2">
      {tendencia.map((t: any) => (
        <div class="flex flex-1 flex-col items-center gap-1">
          <div class="w-full rounded-t-xl bg-gradient-to-t from-xuma-azul to-xuma-verde-oscuro" style={`height:${Math.round((Number(t.total ?? 0) / maxT) * 140)}px`} title={`${t.mes}: ${t.total}`}></div>
          <span class="text-[10px] font-bold uppercase text-tinta/60">{String(t.mes ?? '').slice(0, 3)}</span>
        </div>
      ))}
    </div>
    <div class="mt-3 flex flex-wrap gap-2 text-xs text-tinta/65">
      {tendencia.map((t: any) => (<span class="rounded-full bg-tinta/10 px-3 py-1"><strong>{t.mes}</strong>: {fmt.format(t.total)}</span>))}
    </div>
  </section>

  <section class="glass mt-4 rounded-3xl p-5">
    <h2 class="text-base font-bold">Filtros disponibles</h2>
    <div class="mt-2 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-tinta/10 px-3 py-1">Distribuidoras: {metadatos.distribuidoras.join(', ')}</span>
      <span class="rounded-full bg-tinta/10 px-3 py-1">Cabinas: {metadatos.cabinas.join(', ')}</span>
    </div>
    <p class="mt-3 text-xs text-tinta/60">El dashboard completo con gráficos y filtros avanzados lo definimos en el siguiente paso.</p>
  </section>
</SidebarLayout>
