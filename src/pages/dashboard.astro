---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import FiltrosPanel from '../components/filtros/FiltrosPanel.astro';
import { cargaSSR, filtrosPorDefecto, getDashboardMensual, getMetadatos, METADATOS_VACIOS, parseFiltros } from '../lib/query';

const f = { ...filtrosPorDefecto(), ...parseFiltros(Astro.url) };
const claveFiltros = JSON.stringify(f);
const mensual: any[] = await cargaSSR(`dashboard/mensual/${claveFiltros}`, getDashboardMensual(f), []);
const metadatos = await cargaSSR('dashboard/metadatos', getMetadatos(f), METADATOS_VACIOS);
const fmt = new Intl.NumberFormat('es-CO');

const tot = (k: string) => mensual.reduce((s: number, r: any) => s + Number(r[k] ?? 0), 0);
const T = tot('total'), INB = tot('inbound'), OUT = tot('outbound'), RET = tot('retenidos'), APT = tot('aptos'), NOAP = tot('noAptos');
const PCT = APT > 0 ? Math.round((RET / APT) * 1000) / 10 : 0;

const selMes = f.mes ?? '';
const selGas = (f.gasera ?? [])[0] ?? '';
const selCabina = (f.cabina ?? [])[0] ?? '';
const selEstado = (f.estado ?? [])[0] ?? '';
const gaseras = metadatos.gaseras ?? [];
const cabinas = metadatos.cabinas ?? [];
const estados = metadatos.estados ?? [];
const mesesFiltro = (metadatos.meses ?? []).filter((m) => m !== 'SIN DATO');
const totalBase = metadatos.total ?? 0;

const maxBar = Math.max(1, ...mensual.map((r: any) => Math.max(Number(r.total ?? 0), Number(r.inbound ?? 0), Number(r.outbound ?? 0), Number(r.retenidos ?? 0))));
const maxPct = Math.max(10, ...mensual.map((r: any) => Number(r.pct ?? 0)));
const H = 300;

// Geometría de la línea de % (SVG sobre las columnas)
const n = Math.max(1, mensual.length);
const stepX = 100 / n;
const px = (i: number) => (stepX * i + stepX / 2).toFixed(2);
// Puntos sobre la línea: misma geometría que el SVG (top desde la caja de barras)
const pyNum = (pct: number) => H - 24 - (Number(pct) / maxPct) * (H - 70);
const py = (pct: number) => pyNum(pct).toFixed(1);
const dotTop = (pct: number) => ((pyNum(pct) / H) * (H + 8) - 8 - 7.5).toFixed(1);
const linePts = mensual.map((r: any, i: number) => `${px(i)},${py(Number(r.pct ?? 0))}`).join(' ');

const SERIES = [
  { key: 'total', label: 'Total llamadas', color: 'linear-gradient(180deg,#120180,#3d22c8)', dot: '#3d22c8' },
  { key: 'inbound', label: 'Inbound', color: 'linear-gradient(180deg,#00cd93,#5ae280)', dot: '#00cd93' },
  { key: 'outbound', label: 'Outbound', color: 'linear-gradient(180deg,#8b7bff,#c4b5fd)', dot: '#8b7bff' },
  { key: 'retenidos', label: 'Retenciones', color: 'linear-gradient(180deg,#f59e0b,#fcd34d)', dot: '#f59e0b' },
];

const svgLlamadas = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
const svgIn = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 2 16 6 20 6"/><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
const svgOut = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 2 22 6 18 6"/><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
const svgShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>';
const svgUserCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>';
const svgUserX = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" x2="22" y1="8" y2="13"/><line x1="22" x2="17" y1="8" y2="13"/></svg>';
const svgPct = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="5" y1="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>';
const svgChart = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="20" y2="10"/><line x1="18" x2="18" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="16"/></svg>';

const kpis = [
  { label: 'Total llamadas', valor: T, texto: fmt.format(T), icon: svgLlamadas, chip: 'kpi-azul', num: 'text-tinta' },
  { label: 'Inbound', valor: INB, texto: fmt.format(INB), icon: svgIn, chip: 'kpi-verde', num: 'text-xuma-verde-oscuro' },
  { label: 'Outbound', valor: OUT, texto: fmt.format(OUT), icon: svgOut, chip: 'kpi-violeta', num: 'text-[#5b3df0]' },
  { label: 'Total Aptos', valor: APT, texto: fmt.format(APT), icon: svgUserCheck, chip: 'kpi-teal', num: 'text-teal-600' },
  { label: 'Total No Aptos', valor: NOAP, texto: fmt.format(NOAP), icon: svgUserX, chip: 'kpi-gris', num: 'text-slate-500' },
  { label: 'Retenciones', valor: RET, texto: fmt.format(RET), icon: svgShield, chip: 'kpi-ambar', num: 'text-amber-600' },
  { label: '% Retención', valor: PCT, texto: `${PCT}%`, icon: svgPct, chip: 'kpi-rosa', num: 'text-rose-500' },
];
---

<SidebarLayout title="Dashboard · Gestión Diaria Promigas 2026">
  <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-widest text-tinta/55">Corte · Enero a Septiembre 2026 · Página 1</p>
      <h1 class="flex items-center gap-2 text-2xl font-extrabold md:text-3xl">
        <span class="kpi-ico" set:html={svgChart} /> Dashboard de <span class="texto-brillo">Gestión Diaria</span>
      </h1>
    </div>
  </div>

  <FiltrosPanel
    action="/dashboard"
    opciones={{ mes: mesesFiltro, gasera: gaseras, cabina: cabinas, estado: estados }}
    actual={{ mes: selMes, gasera: selGas, cabina: selCabina, estado: selEstado }}
    totalFiltrado={T}
    totalBase={totalBase}
  />

  <!-- KPIs con diseño, sombra y animación -->
  <section class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-7">
    {kpis.map((k, i) => (
      <article class={`kpi-card show fade-up ${k.chip}`} style={`animation-delay:${0.05 + i * 0.09}s`}>
        <span class="kpi-glow" aria-hidden="true"></span>
        <span class="kpi-ico" set:html={k.icon} />
        <span class="kpi-body">
          <span class="kpi-label">{k.label}</span>
          <span class={`kpi-num ${k.num}`} data-count={k.valor} data-pct={k.label === '% Retención' ? '1' : '0'}>{k.texto}</span>
          {k.nota ? <span class="kpi-nota">{k.nota}</span> : <span class="kpi-nota">&nbsp;</span>}
        </span>
      </article>
    ))}
  </section>

  <!-- Página 1: solo el gráfico grande, todos los meses en el eje X -->
  <section class="glass mt-4 rounded-3xl p-5 md:p-6">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="flex items-center gap-2 text-base font-bold md:text-lg">
        <span class="kpi-ico kpi-ico-sm" set:html={svgChart} /> Gestión mensual: llamadas y retenciones
      </h2>
      <p class="text-xs text-tinta/60">Columnas por mes · línea = % retención</p>
    </div>
    <div class="mt-3 flex flex-wrap gap-2">
      {SERIES.map((s) => (
        <span class="inline-flex items-center gap-2 rounded-full bg-tinta/10 px-3 py-1 text-xs font-bold">
          <span class="inline-block h-3 w-3 rounded" style={`background:${s.dot}`}></span>{s.label}
        </span>
      ))}
      <span class="inline-flex items-center gap-2 rounded-full bg-tinta/10 px-3 py-1 text-xs font-bold">
        <span class="pct-legend-line"></span>% Retención
      </span>
    </div>

    {mensual.length === 0 ? (
      <p class="mt-6 text-sm text-tinta/60">Sin datos para los filtros seleccionados.</p>
    ) : (
      <div class="chart-wrap mt-2 overflow-x-auto">
        <div class="chart-inner">
          <svg class="chart-line pct-ink" viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" aria-hidden="true">
            <polygon points={`${linePts} 100,${H} 0,${H}`} class="pct-area" />
            <polyline points={linePts} fill="none" class="pct-line" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            <polyline points={linePts} fill="none" class="pct-flow" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="chart-cols">
            {mensual.map((r: any, i: number) => (
              <div class="chart-month">
                <div class="chart-bars" style={`height:${H}px`}>
                  {SERIES.map((s, j) => (
                    <div class="bar-col">
                      <span class="bar-val">{fmt.format(r[s.key] ?? 0)}</span>
                      <div class="bar" style={`height:${Math.max(4, Math.round((Number(r[s.key] ?? 0) / maxBar) * (H - 90)))}px;background:${s.color};animation-delay:${0.15 + i * 0.09 + j * 0.05}s`} title={`${r.mes} · ${s.label}: ${fmt.format(r[s.key] ?? 0)}`}></div>
                    </div>
                  ))}
                  <span class="pct-dot pct-ink" style={`left:50%;top:${dotTop(Number(r.pct ?? 0))}px`} title={`${r.mes} · % Retención: ${r.pct}%`}>
                    <span class="pct-tag pct-ink">{r.pct}%</span>
                  </span>
                </div>
                <span class="chart-mes">{String(r.mes ?? '').slice(0, 3)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
    <p class="mt-3 text-[11px] leading-relaxed text-tinta/55">
      Fórmula: <strong>% Retención = Retenidos / Aptos × 100</strong> · Aptos y No Aptos salen de la
      columna <strong>Clasificación</strong> de la base · Mes = columna Mes de la base.
    </p>
  </section>

  <style>
    .show { opacity: 0; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    @keyframes drawLine { from { stroke-dashoffset: 340; } to { stroke-dashoffset: 0; } }
    @keyframes flowDash { to { stroke-dashoffset: -32; } }
    @keyframes floatGlow { 0%,100% { transform: translate(0,0); opacity: .55; } 50% { transform: translate(10px,-12px); opacity: .9; } }
    @media (prefers-reduced-motion: reduce) { .show { opacity: 1; } .bar, .pct-line, .pct-flow, .pct-dot, .pct-area, .kpi-card { animation: none !important; } }
    .fade-up { animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) both; }

    /* KPIs con diseño: icono, sombra, brillo y conteo */
    .kpi-card {
      position: relative; overflow: hidden;
      display: flex; align-items: flex-start; gap: .85rem;
      border-radius: 1.5rem; padding: 1.15rem 1.1rem;
      border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
      background: color-mix(in srgb, Canvas 82%, transparent);
      backdrop-filter: blur(18px);
      box-shadow: 0 24px 50px -28px rgba(18,1,128,.45);
      transition: transform .35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .3s ease;
    }
    .kpi-card:hover { transform: translateY(-6px) scale(1.015); box-shadow: 0 32px 60px -24px rgba(18,1,128,.55); }
    .kpi-glow { position: absolute; top: -34px; right: -34px; width: 110px; height: 110px; border-radius: 999px; filter: blur(30px); opacity: .55; animation: floatGlow 6s ease-in-out infinite; pointer-events: none; }
    .kpi-azul .kpi-glow { background: rgba(18,1,128,.35); } .kpi-verde .kpi-glow { background: rgba(0,205,147,.4); }
    .kpi-violeta .kpi-glow { background: rgba(139,123,255,.45); } .kpi-ambar .kpi-glow { background: rgba(245,158,11,.4); }
    .kpi-teal .kpi-glow { background: rgba(45,212,191,.4); } .kpi-gris .kpi-glow { background: rgba(148,163,184,.4); }
    .kpi-rosa .kpi-glow { background: rgba(244,63,94,.4); }
    .kpi-ico { display: inline-flex; align-items: center; justify-content: center; width: 2.9rem; height: 2.9rem; border-radius: 1rem; flex-shrink: 0; color: #fff; box-shadow: 0 12px 24px -12px rgba(0,0,0,.5); }
    .kpi-ico :global(svg) { width: 1.35rem; height: 1.35rem; }
    .kpi-ico-sm { width: 2rem; height: 2rem; border-radius: .7rem; }
    .kpi-ico-sm :global(svg) { width: 1rem; height: 1rem; }
    .kpi-azul .kpi-ico { background: linear-gradient(135deg,#120180,#3d22c8); }
    .kpi-verde .kpi-ico { background: linear-gradient(135deg,#00cd93,#5ae280); }
    .kpi-violeta .kpi-ico { background: linear-gradient(135deg,#8b7bff,#5b3df0); }
    .kpi-ambar .kpi-ico { background: linear-gradient(135deg,#f59e0b,#fbbf24); }
    .kpi-teal .kpi-ico { background: linear-gradient(135deg,#0d9488,#2dd4bf); }
    .kpi-gris .kpi-ico { background: linear-gradient(135deg,#475569,#94a3b8); }
    .kpi-rosa .kpi-ico { background: linear-gradient(135deg,#f43f5e,#fb7185); }
    h1 .kpi-ico, h2 .kpi-ico { background: linear-gradient(135deg,var(--color-xuma-azul),var(--color-xuma-verde-oscuro)); }
    .kpi-body { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
    .kpi-label { font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; opacity: .55; }
    .kpi-num { font-size: 1.9rem; font-weight: 800; font-variant-numeric: tabular-nums; }
    .kpi-nota { font-size: 10px; opacity: .6; }

    /* Gráfico grande */
    .chart-wrap { position: relative; }
    .chart-inner { position: relative; min-width: 860px; }
    .chart-line { position: absolute; inset: 0 0 26px 0; width: 100%; height: calc(100% - 26px); overflow: visible; }
    /* Línea de %: gris oscuro en claro / blanca en oscuro, gruesa y con área para ver subidas y bajadas */
    .pct-ink { color: #1e293b; }
    :global(.dark) .pct-ink { color: #f8fafc; }
    .pct-area { fill: currentColor; fill-opacity: 0.09; }
    .pct-line { stroke: currentColor; stroke-width: 3; filter: drop-shadow(0 3px 7px rgba(0,0,0,.4)); stroke-dasharray: 340; stroke-dashoffset: 340; animation: drawLine 1.8s ease-out 0.8s forwards; }
    .pct-flow { stroke: currentColor; stroke-width: 3; opacity: .85; stroke-dasharray: 2 14; animation: flowDash 1.1s linear infinite; }
    .pct-legend-line { display: inline-block; height: 4px; width: 1.4rem; border-radius: 999px; background: #1e293b; }
    :global(.dark) .pct-legend-line { background: #f8fafc; }
    .chart-cols { position: relative; display: flex; gap: .5rem; padding-top: .5rem; }
    .chart-month { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .chart-month + .chart-month { border-left: 1px dashed color-mix(in srgb, currentColor 18%, transparent); padding-left: .5rem; }
    .chart-bars { position: relative; display: flex; align-items: flex-end; justify-content: center; gap: .3rem; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); padding-bottom: 2px; }
    .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 3px; height: 100%; min-width: 0; }
    .bar-val { font-size: 12px; font-weight: 800; color: color-mix(in srgb, currentColor 75%, transparent); font-variant-numeric: tabular-nums; }
    .bar { width: 100%; max-width: 30px; border-radius: 7px 7px 3px 3px; box-shadow: 0 8px 18px -10px rgba(18,1,128,.5); }
    .chart-mes { margin-top: .45rem; text-align: center; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; opacity: .85; background: color-mix(in srgb, currentColor 7%, transparent); border-radius: 999px; padding: .2rem .1rem; }
    .pct-dot { position: absolute; width: 15px; height: 15px; margin-left: -7.5px; border-radius: 999px; background: #fff; border: 3.5px solid currentColor; box-shadow: 0 3px 10px rgba(0,0,0,.4); }
    .pct-tag { position: absolute; bottom: 17px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums; color: currentColor; background: color-mix(in srgb, currentColor 12%, Canvas 88%); border: 1px solid currentColor; border-radius: 999px; padding: 2px 8px; }
  </style>

  <script is:inline>
    // Conteo animado de los KPIs al cargar.
    (function () {
      try {
        var els = document.querySelectorAll('.kpi-num[data-count]');
        if (!els.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var fmt = new Intl.NumberFormat('es-CO');
        els.forEach(function (el) {
          var target = parseFloat(el.getAttribute('data-count') || '0');
          var isPct = el.getAttribute('data-pct') === '1';
          var t0 = null, dur = 1100;
          function tick(t) {
            if (!t0) t0 = t;
            var p = Math.min(1, (t - t0) / dur);
            var e = 1 - Math.pow(1 - p, 3);
            var v = target * e;
            el.textContent = isPct ? (Math.round(v * 10) / 10) + '%' : fmt.format(Math.round(v));
            if (p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      } catch (e) {}
    })();
  </script>
</SidebarLayout>
