---
// Embudo de gestión (réplica del flujo de GasCaribe), en versión SSR/Astro:
// Total general → Inbound / Outbound → Aptas / No aptas → Retenciones,
// con el % de retención debajo y los detalles de la gestión a la derecha.
// Todos los pasos se renderizan siempre (así el embudo conserva su forma)
// y el panel lateral muestra valores y % del total por paso.
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptos: number;
  noAptos: number;
  retenciones: number;
  pct: number;
}
const { total, inbound, outbound, aptos, noAptos, retenciones, pct } = Astro.props;
const fmt = new Intl.NumberFormat('es-CO');
const n = (v: number | undefined) => Number(v ?? 0) || 0;

const T = n(total);
const pasos = [
  { key: 'total', label: 'Total general', value: T, color: '#120180' },
  { key: 'inbound', label: 'Inbound', value: n(inbound), color: '#8b5cf6' },
  { key: 'outbound', label: 'Outbound', value: n(outbound), color: '#06b6d4' },
  { key: 'aptos', label: 'Aptas', value: n(aptos), color: '#0d9488' },
  { key: 'noAptos', label: 'No aptas', value: n(noAptos), color: '#f43f5e' },
  { key: 'retenciones', label: 'Retenciones', value: n(retenciones), color: '#2563eb' },
];
const stepHeight = 30;
const gap = 4;
const svgWidth = 300;
const maxFunnelWidth = 230;
const minFunnelWidth = 76;
const funnelOffsetX = (svgWidth - maxFunnelWidth) / 2;

const maxVal = Math.max(T, 1);
interface Step { key: string; label: string; value: number; color: string; pctOfTotal: number; width: number }
const steps: Step[] = [];
for (let i = 0; i < pasos.length; i++) {
  const s = pasos[i]!;
  const pctOfTotal = (s.value / maxVal) * 100;
  const width = Math.max((pctOfTotal / 100) * maxFunnelWidth, s.value > 0 ? minFunnelWidth : 34);
  steps.push({ ...s, pctOfTotal, width });
}
const pctRetencion = pct;
const pctFila = (v: number) => (T > 0 ? (n(v) / T) * 100 : 0);
const shareIn = pctFila(inbound);
const shareOut = pctFila(outbound);
const shareAptos = pctFila(aptos);
const shareNoAptos = pctFila(noAptos);

// La figura del % de retención NUNCA puede ser más grande que la de Retenciones.
const idxRet = steps.findIndex((s) => s.key === 'retenciones');
const anchoRef = idxRet >= 0 ? steps[idxRet]!.width : maxFunnelWidth;
const anchoPct = Math.max(46, Math.min(110, anchoRef - 18));
const altoPct = 26;
const svgHeight = steps.length * (stepHeight + gap) + altoPct + 20;
---
<section class="glass mt-3 rounded-3xl p-4 md:p-5">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 text-base font-bold md:text-lg">
      <span class="kpi-ico kpi-ico-sm" style="background:linear-gradient(135deg,#120180,#3d22c8)">▾</span>
      Embudo de gestión
    </h2>
    <p class="text-[11px] font-semibold text-tinta/60 md:text-xs">Total general → Inbound / Outbound → Aptas / No aptas → Retenciones</p>
  </div>

  <div class="mt-3 grid items-start gap-4 md:grid-cols-[auto_1fr]">
    <!-- SVG del embudo -->
    <div class="mx-auto w-full max-w-sm md:mx-0 md:w-[280px]">
      <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} preserveAspectRatio="xMidYMid meet" class="w-full h-auto" role="img" aria-label="Embudo de gestión">
        <defs>
          <linearGradient id="pctGradPromi" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1e40af" />
            <stop offset="100%" stop-color="#3b82f6" />
          </linearGradient>
        </defs>
        <g transform={`translate(${funnelOffsetX}, 4)`}>
          {steps.map((step, i) => {
            const width = step.width;
            const x = (maxFunnelWidth - width) / 2;
            const y = i * (stepHeight + gap);
            const isLast = i === steps.length - 1;
            const nextWidth = isLast ? Math.max(width - 8, 26) : steps[i + 1]!.width;
            const nextX = (maxFunnelWidth - nextWidth) / 2;
            const centerX = maxFunnelWidth / 2;
            const centerY = y + stepHeight / 2;
            const dimmed = step.value === 0;
            return (
              <g class="cursor-default">
                <title>{`${step.label}: ${fmt.format(step.value)} (${step.pctOfTotal.toFixed(1)}% del total)`}</title>
                <path
                  d={isLast
                    ? `M ${x} ${y} L ${x + width} ${y} L ${x + width - 5} ${y + stepHeight} L ${x + 5} ${y + stepHeight} Z`
                    : `M ${x} ${y} L ${x + width} ${y} L ${nextX + nextWidth} ${y + stepHeight} L ${nextX} ${y + stepHeight} Z`}
                  fill={step.color}
                  fill-opacity={dimmed ? 0.28 : 0.88}
                  stroke="rgba(255,255,255,0.14)"
                  stroke-width="0.5"
                />
                <text x={centerX} y={centerY - 7} text-anchor="middle" dominant-baseline="central" font-size="8" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {step.label}
                </text>
                <text x={centerX} y={centerY + 0.5} text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {fmt.format(step.value)}
                </text>
                <text x={centerX} y={centerY + 8} text-anchor="middle" dominant-baseline="central" font-size="6.6" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {step.pctOfTotal.toFixed(1)}%
                </text>
              </g>
            );
          })}
          <g transform={`translate(${maxFunnelWidth / 2}, ${steps.length * (stepHeight + gap) + 2})`}>
            <path
              d={`M ${-anchoPct / 2} 0 L ${anchoPct / 2} 0 L ${anchoPct / 2 - 4} ${altoPct} L ${-anchoPct / 2 + 4} ${altoPct} Z`}
              fill="url(#pctGradPromi)"
              stroke="rgba(255,255,255,0.18)"
              stroke-width="0.5"
            />
            <text x={0} y={altoPct / 2 - 5.5} text-anchor="middle" dominant-baseline="central" font-size={anchoPct >= 80 ? 7 : 6} font-weight="700" fill="rgba(255,255,255,0.92)">
              % Ret (Ret/Aptas)
            </text>
            <text x={0} y={altoPct / 2 + 4.5} text-anchor="middle" dominant-baseline="central" font-size={anchoPct >= 80 ? 10.5 : 9} font-weight="800" fill="#fff">
              {pctRetencion.toFixed(1)}%
            </text>
          </g>
        </g>
      </svg>
    </div>

    <!-- Detalles de la gestión -->
    <div class="w-full space-y-2">
      <ul class="grid grid-cols-2 gap-1.5 text-[11px] sm:grid-cols-3 lg:grid-cols-6 md:grid-cols-3">
        {steps.map((s) => (
          <li class="rounded-xl border border-tinta/10 bg-tinta/5 px-2 py-1.5">
            <span class="flex items-center gap-1.5 font-bold text-tinta/80">
              <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-sm" style={`background:${s.color}`}></span>
              <span class="truncate">{s.label}</span>
            </span>
            <span class="mt-0.5 block text-sm font-extrabold tabular-nums leading-tight text-tinta">{fmt.format(s.value)}</span>
            <span class="block text-[10px] font-semibold tabular-nums text-tinta/55">{s.pctOfTotal.toFixed(1)}% del total</span>
          </li>
        ))}
      </ul>

      <div class="rounded-2xl border border-tinta/10 bg-tinta/5 p-3 md:p-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-tinta/55">Detalles de la gestión</p>
        <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[11px] sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <span class="text-tinta/60">Share inbound</span>
            <p class="font-extrabold tabular-nums">{shareIn.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(inbound))})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">Share outbound</span>
            <p class="font-extrabold tabular-nums">{shareOut.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(outbound))})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">Aptas sobre total</span>
            <p class="font-extrabold tabular-nums text-teal-700 dark:text-teal-400">{shareAptos.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(aptos))})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">No aptas sobre total</span>
            <p class="font-extrabold tabular-nums text-rose-600 dark:text-rose-400">{shareNoAptos.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(noAptos))})</span></p>
          </div>
        </div>
        <div class="mt-3 flex flex-col gap-2 border-t border-tinta/10 pt-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="text-[11px] text-tinta/60">
            Retenidos = <span class="font-bold text-tinta/85">RETENIDO + CANCELADO + VENTA</span><br />
            Base de retención: <span class="font-bold text-tinta/85">solo Aptas</span>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-blue-600/20 bg-blue-600/10 px-3 py-2">
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-blue-700 dark:text-blue-300">% Retención</p>
              <p class="text-xl font-extrabold tabular-nums leading-none text-blue-700 dark:text-blue-300">{pctRetencion.toFixed(1)}%</p>
            </div>
            <div class="text-[10px] font-semibold leading-tight text-tinta/60">
              {fmt.format(n(retenciones))} retenidos<br />
              de {fmt.format(n(aptos))} aptas
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
