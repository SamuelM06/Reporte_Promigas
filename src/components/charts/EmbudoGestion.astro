---
// Embudo de gestión — versión horizontal por niveles (según especificación).
// Layout: [etiquetas ~200px] [embudo flexible] [métricas ~220px].
// Todo se calcula con las variables existentes; sin valores hardcodeados.
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptas: number;
  noAptas: number;
  retenciones: number;
  pct: number;
  inboundAptas?: number;
  inboundNoAptas?: number;
  inboundRetenciones?: number;
  outboundAptas?: number;
  outboundNoAptas?: number;
  outboundRetenciones?: number;
}
const {
  total, inbound, outbound, aptas, noAptas, retenciones, pct,
  inboundAptas, inboundNoAptas, inboundRetenciones,
  outboundAptas, outboundNoAptas, outboundRetenciones,
} = Astro.props;

const fmt = new Intl.NumberFormat('es-CO');
const fmtPct = (v: number) => new Intl.NumberFormat('es-CO', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(v) + ' %';
const n = (v: number | undefined) => Number(v ?? 0) || 0;

const T = n(total);
const IN = n(inbound);
const OUT = n(outbound);
const APT = n(aptas);
// Respaldo para el bug de mapeo: si noAptas llega 0/undefined, derivarla
const NOAP = noAptas != null ? n(noAptas) : Math.max(0, T - APT);
const RET = n(retenciones);
const PCT = n(pct);

const APT_IN = n(inboundAptas);
const NOAP_IN = inboundNoAptas != null ? n(inboundNoAptas) : Math.max(0, IN - APT_IN);
const RET_IN = n(inboundRetenciones);
const APT_OUT = n(outboundAptas);
const NOAP_OUT = outboundNoAptas != null ? n(outboundNoAptas) : Math.max(0, OUT - APT_OUT);
const RET_OUT = n(outboundRetenciones);

// Derivados (protegidos contra división por 0)
const pctInbound  = T > 0 ? (IN / T) * 100 : 0;
const pctOutbound = T > 0 ? (OUT / T) * 100 : 0;
const pctAptas    = T > 0 ? (APT / T) * 100 : 0;
const pctNoAptas  = T > 0 ? (NOAP / T) * 100 : 0;
const aptasSinRetener = Math.max(0, APT - RET);
const pctSinRetenerSobreAptas = APT > 0 ? (aptasSinRetener / APT) * 100 : 0;
const tasaRetencion = APT > 0 ? (RET / APT) * 100 : 0;
const retencionSobreTotal = T > 0 ? (RET / T) * 100 : 0;

// Mínimo ~10 % solo si el valor es mayor a 0 pero muy pequeño; normalizado a 100
const minBlock = 10;
const norm2 = (a: number, b: number) => {
  const ra = a > 0 ? Math.max(minBlock, a) : 0;
  const rb = b > 0 ? Math.max(minBlock, b) : 0;
  const s = ra + rb;
  if (s <= 0) return { a: 50, b: 50 };
  return { a: (ra / s) * 100, b: (rb / s) * 100 };
};
const { a: wIn, b: wOut } = norm2(pctInbound, pctOutbound);
const { a: wApt, b: wNoA } = norm2(pctAptas, pctNoAptas);

// Retenidos: ancho = ancho del bloque Aptas (alineado a la izquierda)
const wRet = wApt;
// % Retención: 70 % del trapecio de Retenidos
const wPct = wRet * 0.7;

// Tabla "Detalle por cabina"
const filasCabina = [
  { label: 'Inbound', color: '#8b5cf6', llamadas: IN, aptas: APT_IN, noAptas: NOAP_IN, retenciones: RET_IN },
  { label: 'Outbound', color: '#06b6d4', llamadas: OUT, aptas: APT_OUT, noAptas: NOAP_OUT, retenciones: RET_OUT },
  { label: 'Total', color: '#3b82f6', llamadas: T, aptas: APT, noAptas: NOAP, retenciones: RET },
];
const pctRetSobreAptas = (r: { aptas: number; retenciones: number }) => r.aptas > 0 ? (r.retenciones / r.aptas) * 100 : 0;
const pctRetSobreTotal = (r: { llamadas: number; retenciones: number }) => r.llamadas > 0 ? (r.retenciones / r.llamadas) * 100 : 0;
---
<section class="embudo-card">
  <!-- Encabezado -->
  <div class="embudo-head">
    <h2 class="embudo-titulo">Embudo de gestión</h2>
    <p class="embudo-subtitulo">Total → Aptas → Retenciones</p>
  </div>

  <!-- Frase generada con variables -->
  <p class="embudo-frase">
    De <strong>{fmt.format(T)}</strong> llamadas, <strong>{fmt.format(APT)}</strong> fueron aptas y <strong>{fmt.format(RET)}</strong> se retuvieron.
  </p>

  <!-- Layout 3 columnas -->
  <div class="embudo-grid">
    <!-- Fila 1: Total -->
    <div class="embudo-funnel-cell" style="grid-row:1; grid-column:2;">
      <div class="embudo-row embudo-row-total">
        <div class="embudo-block embudo-total" style="width:100%">
          <div class="embudo-bg"></div>
          <div class="embudo-content embudo-content-total">
            <span class="embudo-nombre">TOTAL DE LLAMADAS</span>
            <span class="embudo-valor">{fmt.format(T)}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Fila 2: Cabina -->
    <div class="embudo-label-cell" style="grid-row:2; grid-column:1;">
      <span class="embudo-label">Cabina</span>
      <span class="embudo-sub">inbound + outbound</span>
    </div>
    <div class="embudo-funnel-cell" style="grid-row:2; grid-column:2;">
      <div class="embudo-row embudo-row-cabina">
        <div class="embudo-block embudo-inbound" style={`width:${wIn}%`}>
          <div class="embudo-bg"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">INBOUND</span>
            <span class="embudo-valor">{fmt.format(IN)}</span>
            <span class="embudo-pct">{fmtPct(pctInbound)}</span>
          </div>
        </div>
        <div class="embudo-block embudo-outbound" style={`width:${wOut}%`}>
          <div class="embudo-bg"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">OUTBOUND</span>
            <span class="embudo-valor">{fmt.format(OUT)}</span>
            <span class="embudo-pct">{fmtPct(pctOutbound)}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Fila 3: Clasificación -->
    <div class="embudo-label-cell" style="grid-row:3; grid-column:1;">
      <span class="embudo-label">Clasificación</span>
      <span class="embudo-sub">aptas + no aptas</span>
    </div>
    <div class="embudo-funnel-cell" style="grid-row:3; grid-column:2;">
      <div class="embudo-row embudo-row-clasif">
        <div class="embudo-block embudo-aptas" style={`width:${wApt}%`}>
          <div class="embudo-bg"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">APTAS</span>
            <span class="embudo-valor">{fmt.format(APT)}</span>
            <span class="embudo-pct">{fmtPct(pctAptas)}</span>
          </div>
        </div>
        <div class="embudo-block embudo-noaptas" style={`width:${wNoA}%`}>
          <div class="embudo-bg"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">NO APTAS</span>
            <span class="embudo-valor">{fmt.format(NOAP)}</span>
            <span class="embudo-pct">{fmtPct(pctNoAptas)}</span>
          </div>
        </div>
      </div>
    </div>
    <div class="embudo-metric-cell" style="grid-row:3; grid-column:3;">
      <span class="embudo-metric-valor embudo-metric-amarillo">{fmt.format(aptasSinRetener)}</span>
      <span class="embudo-metric-txt">aptas sin retener · {fmtPct(pctSinRetenerSobreAptas)} de las aptas</span>
    </div>

    <!-- Fila 4: Retención -->
    <div class="embudo-label-cell" style="grid-row:4; grid-column:1;">
      <span class="embudo-label">Retención</span>
      <span class="embudo-sub">solo sobre las aptas</span>
    </div>
    <div class="embudo-funnel-cell" style="grid-row:4; grid-column:2;">
      <div class="embudo-row embudo-row-ret">
        <div class="embudo-block embudo-retenidos" style={`width:${wApt}%`}>
          <div class="embudo-bg embudo-bg-trap"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">RETENCIONES</span>
            <span class="embudo-valor">{fmt.format(RET)}</span>
            <span class="embudo-pct">{fmtPct(pctAptas > 0 ? (RET / APT) * 100 : 0)} del total</span>
          </div>
        </div>
        <div class="embudo-noaptas-note">Las no aptas no generan retención.</div>
      </div>
    </div>
    <div class="embudo-metric-cell" style="grid-row:4; grid-column:3;">
      <span class="embudo-metric-valor">{fmtPct(tasaRetencion)}</span>
      <span class="embudo-metric-txt">tasa de retención (retenciones ÷ aptas)</span>
      <span class="embudo-metric-valor embudo-metric-small">{fmtPct(retencionSobreTotal)}</span>
      <span class="embudo-metric-txt">sobre el total de llamadas</span>
    </div>

    <!-- Fila 5: % Retención -->
    <div class="embudo-funnel-cell" style="grid-row:5; grid-column:2;">
      <div class="embudo-row embudo-row-pct">
        <div class="embudo-block embudo-pct" style={`width:${wPct}%`}>
          <div class="embudo-bg embudo-bg-trap"></div>
          <div class="embudo-content">
            <span class="embudo-nombre">% RETENCIÓN</span>
            <span class="embudo-valor">{fmtPct(PCT)}</span>
            <span class="embudo-pct">Ret / Aptas</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabla "Detalle por cabina" -->
  <div class="embudo-tabla">
    <div class="embudo-tabla-titulo">DETALLE POR CABINA</div>
    <table class="embudo-tbl">
      <thead>
        <tr>
          <th>DETALLE POR CABINA</th>
          <th>LLAMADAS</th>
          <th>APTAS</th>
          <th>NO APTAS</th>
          <th>RETENCIONES</th>
          <th>% RET. S/ APTAS</th>
          <th>% RET. S/ TOTAL</th>
        </tr>
      </thead>
      <tbody>
        {filasCabina.map((r, i) => (
          <tr class={i === 2 ? 'embudo-tbl-total' : ''}>
            <td>
              <span class="embudo-dot" style={`background:${r.color}`}></span>
              {r.label}
            </td>
            <td>{fmt.format(r.llamadas)}</td>
            <td>{fmt.format(r.aptas)}</td>
            <td>{fmt.format(r.noAptas)}</td>
            <td>{fmt.format(r.retenciones)}</td>
            <td>{fmtPct(pctRetSobreAptas(r))}</td>
            <td>{fmtPct(pctRetSobreTotal(r))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  /* Variables de tema (mecanismo existente: clase .dark) */
  :global(:root) {
    --card-bg: #ffffff;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #64748b;
    --border: #e2e8f0;
    --gap-color: #ffffff;
    --amarillo-aptas: #b45309;
  }
  :global(.dark) {
    --card-bg: #1c1f3a;
    --text-primary: #ffffff;
    --text-secondary: #cbd5e1;
    --text-muted: #94a3b8;
    --border: rgba(255, 255, 255, 0.1);
    --gap-color: #1c1f3a;
    --amarillo-aptas: #fcd34d;
  }

  .embudo-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    padding: 1rem 1.25rem;
    font-family: 'Raleway', 'Inter', system-ui, sans-serif;
  }
  .embudo-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .embudo-titulo { font-size: 16px; font-weight: 800; color: var(--text-primary); margin: 0; }
  .embudo-subtitulo { font-size: 11px; font-weight: 600; color: var(--text-muted); margin: 0; }
  .embudo-frase { text-align: center; font-size: 13px; color: var(--text-secondary); margin: 10px 0 14px; }
  .embudo-frase strong { color: var(--text-primary); font-weight: 800; }

  .embudo-grid {
    display: grid;
    grid-template-columns: 200px 1fr 220px;
    grid-template-rows: auto auto auto auto auto;
    gap: 3px 14px;
    align-items: center;
  }
  .embudo-label-cell {
    display: flex; flex-direction: column; align-items: flex-end; justify-content: center;
    text-align: right; padding-right: 6px;
  }
  .embudo-label { font-size: 13px; font-weight: 800; color: var(--text-primary); letter-spacing: 0.02em; }
  .embudo-sub { font-size: 10px; color: var(--text-muted); margin-top: 2px; }

  .embudo-funnel-cell { display: flex; flex-direction: column; gap: 3px; }
  .embudo-row { display: flex; gap: 3px; height: 72px; align-items: stretch; }
  .embudo-row-total { height: 78px; }
  .embudo-row-pct { height: 64px; justify-content: center; }

  .embudo-block {
    position: relative;
    overflow: visible;
    border-radius: 4px;
    box-shadow: 0 6px 18px -8px rgba(0,0,0,0.45);
    min-width: 0;
  }
  .embudo-bg {
    position: absolute; inset: 0; z-index: 0;
  }
  .embudo-content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 100%; padding: 0 4px;
    white-space: nowrap;
    background: transparent;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    user-select: none;
    line-height: 1.15;
  }
  /* textos dentro de figuras saturadas: blancos en ambos temas */
  .embudo-content .embudo-nombre { color: #ffffff; }
  .embudo-content .embudo-valor { color: #ffffff; }
  .embudo-content .embudo-pct { color: rgba(255,255,255,0.88); }

  .embudo-nombre { font-size: clamp(9px, 0.8vw, 11px); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .embudo-valor { font-size: clamp(18px, 2vw, 26px); font-weight: 800; font-variant-numeric: tabular-nums; margin-top: 2px; }
  .embudo-pct { font-size: clamp(9px, 0.75vw, 10px); font-weight: 600; margin-top: 2px; }

  /* colores de fondo por figura (en la capa .embudo-bg) */
  .embudo-total .embudo-bg { background: linear-gradient(135deg, #3b82f6, #2563eb); border-radius: 10px 10px 0 0; }
  .embudo-inbound .embudo-bg { background: linear-gradient(135deg, #8b5cf6, #7c3aed); clip-path: polygon(0 0, 100% 0, 100% 100%, 1% 100%); }
  .embudo-outbound .embudo-bg { background: linear-gradient(135deg, #06b6d4, #0891b2); clip-path: polygon(0 0, 100% 0, 99% 100%, 0 100%); }
  .embudo-aptas .embudo-bg { background: linear-gradient(135deg, #10a37f, #0f7a58); clip-path: polygon(0 0, 100% 0, 100% 100%, 1% 100%); }
  .embudo-noaptas .embudo-bg { background: linear-gradient(135deg, #d97706, #b45309); clip-path: polygon(0 0, 100% 0, 90% 100%, 0 100%); }
  .embudo-retenidos .embudo-bg { background: linear-gradient(135deg, #0f7a58, #065f46); clip-path: polygon(0 0, 100% 0, 85% 100%, 15% 100%); }
  .embudo-pct .embudo-bg { background: linear-gradient(135deg, #2563eb, #1e40af); clip-path: polygon(0 0, 100% 0, 85% 100%, 15% 100%); }

  .embudo-content-total { flex-direction: row; gap: 12px; }

  .embudo-noaptas-note {
    display: flex; align-items: center;
    font-size: 10px; color: var(--text-muted);
    border-left: 1px dotted var(--border);
    padding-left: 8px; margin-left: 4px;
    white-space: nowrap; user-select: none;
    flex: 1 1 auto; min-width: 0;
  }

  .embudo-metric-cell {
    display: flex; flex-direction: column; justify-content: center; gap: 2px;
    padding-left: 8px;
  }
  .embudo-metric-valor { font-size: 20px; font-weight: 800; color: var(--text-primary); font-variant-numeric: tabular-nums; line-height: 1; }
  .embudo-metric-amarillo { color: var(--amarillo-aptas); }
  .embudo-metric-small { font-size: 16px; margin-top: 6px; }
  .embudo-metric-txt { font-size: 10px; color: var(--text-muted); margin-top: 2px; line-height: 1.2; }

  /* Tabla Detalle por cabina */
  .embudo-tabla { margin-top: 16px; border-top: 1px solid var(--border); padding-top: 12px; }
  .embudo-tabla-titulo { font-size: 10px; font-weight: 800; letter-spacing: 0.18em; color: var(--text-muted); margin-bottom: 8px; }
  .embudo-tbl { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 12px; font-variant-numeric: tabular-nums; }
  .embudo-tbl th { font-size: 9px; font-weight: 800; letter-spacing: 0.08em; color: var(--text-muted); padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--border); background: transparent; }
  .embudo-tbl th:first-child { text-align: left; }
  .embudo-tbl td { padding: 8px; text-align: right; border-bottom: 1px solid var(--border); color: var(--text-secondary); background: transparent; }
  .embudo-tbl td:first-child { text-align: left; font-weight: 700; display: flex; align-items: center; gap: 6px; color: var(--text-primary); }
  .embudo-tbl .embudo-tbl-total td { font-weight: 800; color: var(--text-primary); border-top: 1px solid var(--border); }
  .embudo-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

  /* Responsive */
  @media (max-width: 900px) {
    .embudo-grid { grid-template-columns: 1fr; }
    .embudo-label-cell { display: none; }
    .embudo-metric-cell { grid-column: 1; display: block; margin-top: 10px; padding-left: 0; }
    .embudo-noaptas-note { display: none; }
  }
  @media (max-width: 480px) {
    .embudo-valor { font-size: clamp(16px, 4vw, 20px); }
    .embudo-nombre { font-size: clamp(8px, 2vw, 10px); }
    .embudo-row { height: 62px; }
    .embudo-row-total { height: 68px; }
    .embudo-row-pct { height: 56px; }
  }
  /* Prevención de recorte de texto y selección azul */
  .embudo-content span { white-space: nowrap; background: transparent; -webkit-background-clip: border-box; background-clip: border-box; user-select: none; padding: 0 4px; }
  .embudo-content span::selection { background: transparent; color: inherit; }
  :global(::selection) { background: rgba(59,130,246,0.3); }
</style>
