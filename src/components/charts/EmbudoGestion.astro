---
// Embudo de gestión — estilo 3D (capas apiladas con efecto de volumen)
// Layout: [embudo ~40% | panel detalle ~60%]
// Props: total, inbound, outbound, aptas, noAptas, retenciones, pct,
//        inboundAptas, inboundNoAptas, inboundRetenciones,
//        outboundAptas, outboundNoAptas, outboundRetenciones
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptas: number;
  noAptas: number;
  retenciones: number;
  pct: number;
  inboundAptas?: number;
  inboundNoAptas?: number;
  inboundRetenciones?: number;
  outboundAptas?: number;
  outboundNoAptas?: number;
  outboundRetenciones?: number;
}

const {
  total, inbound, outbound, aptas, noAptas, retenciones, pct,
  inboundAptas, inboundNoAptas, inboundRetenciones,
  outboundAptas, outboundNoAptas, outboundRetenciones,
} = Astro.props;

const fmt = new Intl.NumberFormat('es-CO');
const fmtPct = (v: number) => new Intl.NumberFormat('es-CO', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
}).format(v) + ' %';

import { fmtInt } from '../../lib/util';

const n = (v: unknown) => Number(v ?? 0) || 0;

const T = n(total);
const IN = n(inbound);
const OUT = n(outbound);
const APT = n(aptas);
const NOAP = noAptas != null ? n(noAptas) : Math.max(0, T - APT);
const RET = n(retenciones);

// Derivados protegidos contra división por 0
const pctAptas    = T > 0 ? (APT / T) * 100 : 0;
const pctNoAptas  = T > 0 ? (NOAP / T) * 100 : 0;
const aptasSinRetener = Math.max(0, APT - RET);
const pctSinRetenerSobreAptas = APT > 0 ? (aptasSinRetener / APT) * 100 : 0;
const tasaRetencion = APT > 0 ? (RET / APT) * 100 : 0;
const retencionSobreTotal = T > 0 ? (RET / T) * 100 : 0;
const pctInbound  = T > 0 ? (IN / T) * 100 : 0;
const pctOutbound = T > 0 ? (OUT / T) * 100 : 0;

// Embudo 3D apilado: 4 secciones tipo tronco de cono invertido.
// Cada sección: elipse superior (boca, más oscura, con degradado) + cuerpo con
// degradado vertical y brillo lateral izquierdo + borde inferior curvo.
// Las secciones son más angostas hacia abajo y están ligeramente superpuestas:
// el borde curvo inferior de cada una tapa parcialmente la boca de la siguiente.
// Geometría fija y simétrica sobre un viewBox "0 0 400 410"; solo los
// textos/porcentajes vienen de las props.
const capas = [
  { key: 'total',   label: 'TOTAL DE LLAMADAS', valor: T,    pctTxt: null as string | null,                    top: '#5ea2ff', bottom: '#2b6de0', mouthA: '#2e4a76', mouthB: '#1b2c4e', edge: '#1d4f9e', w: 234 },
  { key: 'aptas',   label: 'APTAS',             valor: APT,  pctTxt: `${fmtPct(pctAptas)} del total`,          top: '#3fdd9d', bottom: '#0f9d67', mouthA: '#0e6a47', mouthB: '#054028', edge: '#0a7a50', w: 187 },
  { key: 'noaptas', label: 'NO APTAS',          valor: NOAP, pctTxt: `${fmtPct(pctNoAptas)} del total`,        top: '#ffb45e', bottom: '#f97316', mouthA: '#8f4013', mouthB: '#572205', edge: '#c2410c', w: 151 },
  { key: 'retenc',  label: 'RETENCIONES',       valor: RET,  pctTxt: `${fmtPct(tasaRetencion)} de retención`,  top: '#bd8bff', bottom: '#8b5cf6', mouthA: '#3e1666', mouthB: '#22083c', edge: '#6d28d9', w: 120 },
];

const CX = 130;
const ALT = [60, 54, 54, 54];
const Y0 = 18;
const BULG = 10;
const RYS = [16, 13, 11, 9];
const VALOR_FS = [21, 18, 18, 18];

// Y de la boca de cada sección: solape pequeño, solo para el efecto de capas
// (~30 % de la altura de la boca siguiente cubierta por la sección de arriba).
const PASOS = ALT.slice(0, -1).map((h, i) => Math.round(h + BULG - 0.4 * RYS[i + 1]!));
const ys = [Y0];
for (let i = 0; i < PASOS.length; i++) ys.push(ys[i]! + PASOS[i]!);
const bottomW = (i: number) => (i < capas.length - 1 ? capas[i + 1]!.w : capas[i]!.w * 0.62);
const FIN_EMBUDO = ys[3]! + ALT[3]!;

// Cuerpo con borde inferior curvo (curva de elipse)
function pathCuerpo3d(topW: number, botW: number, y: number, h: number): string {
  const t = topW / 2, b = botW / 2;
  return `M ${CX - t} ${y} L ${CX - b} ${y + h} Q ${CX} ${y + h + 2 * BULG} ${CX + b} ${y + h} L ${CX + t} ${y} Z`;
}

// Borde inferior curvo, por separado (para definirlo con un trazo sutil)
function pathBordeCurvo(botW: number, y: number, h: number): string {
  const b = botW / 2;
  return `M ${CX - b} ${y + h} Q ${CX} ${y + h + 2 * BULG} ${CX + b} ${y + h}`;
}

// Orden de pintado: de abajo hacia arriba (las secciones de arriba tapan
// parcialmente la boca de las de abajo).
const pintado = capas.map((c, i) => ({ c, i })).reverse();
---

<article class="embudo-contenedor">
  <header class="embudo-head">
    <h2 class="embudo-titulo">Embudo de gestión</h2>
    <span class="embudo-subtitulo">Total → Aptas → Retenciones</span>
  </header>

  <div class="embudo-layout">
    <!-- Columna izquierda: Embudo 3D -->
    <div class="embudo-columna-izq">
      <svg class="embudo-svg" viewBox="0 0 260 290" role="img" aria-label="Embudo de gestión: total de llamadas, aptas, no aptas y retenciones">
        <defs>
          {capas.map((c) => (
            <linearGradient id={`grad-${c.key}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={c.top} />
              <stop offset="100%" stop-color={c.bottom} />
            </linearGradient>
          ))}
          {capas.map((c) => (
            <linearGradient id={`boca-${c.key}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color={c.mouthA} />
              <stop offset="100%" stop-color={c.mouthB} />
            </linearGradient>
          ))}
          <!-- Brillo lateral izquierdo para dar volumen al tronco -->
          <linearGradient id="brillo" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.38" />
            <stop offset="28%" stop-color="#ffffff" stop-opacity="0.10" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0" />
          </linearGradient>
          <!-- Sombra única difuminada bajo todo el embudo -->
          <radialGradient id="sombra" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0%" stop-color="#000000" stop-opacity="0.42" />
            <stop offset="70%" stop-color="#000000" stop-opacity="0.13" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Sombra única difuminada bajo todo el embudo -->
        <ellipse cx={CX} cy={FIN_EMBUDO + 8} rx={52} ry={7.5} fill="url(#sombra)" />

        <!-- Secciones apiladas, pintadas de abajo hacia arriba -->
        {pintado.map(({ c, i }) => {
          const y = ys[i]!;
          const R = RYS[i]!;
          const H = ALT[i]!;
          const topW = c.w;
          const botW = bottomW(i);
          const dCuerpo = pathCuerpo3d(topW, botW, y, H);
          const conPct = Boolean(c.pctTxt);
          // Texto centrado sobre la zona visible del cuerpo (bajo la boca)
          const nameY = conPct ? y + R + 11 : y + R + 13;
          const valY = conPct ? y + R + 28 : y + R + 33;
          const pctY = y + R + 42;
          return (
            <g class="capa" style={`animation-delay:${i * 0.13}s`}>
              <!-- Cuerpo del tronco (degradado vertical claro→ligeramente oscuro) -->
              <path d={dCuerpo} fill={`url(#grad-${c.key})`} />
              <!-- Brillo lateral izquierdo -->
              <path d={dCuerpo} fill="url(#brillo)" />
              <!-- Borde inferior curvo definido -->
              <path d={pathBordeCurvo(botW, y, H)} fill="none" stroke={c.edge} stroke-width="1.3" stroke-opacity="0.75" />
              <!-- Boca del cono (elipse, más oscura, con degradado) -->
              <ellipse cx={CX} cy={y} rx={topW / 2} ry={R} fill={`url(#boca-${c.key})`} />
              <!-- Texto centrado sobre el eje central del embudo -->
              <text x={CX} y={nameY} class="texto-etiqueta">{c.label}</text>
              <text x={CX} y={valY} class="texto-valor" style={`font-size:${VALOR_FS[i]}px`}>{fmt.format(c.valor)}</text>
              {c.pctTxt && <text x={CX} y={pctY} class="texto-pct">{c.pctTxt}</text>}
            </g>
          );
        })}
      </svg>
    </div>

    <!-- Columna derecha: Panel de detalle -->
    <div class="embudo-columna-der">
      <!-- Métricas clave -->
      <section class="metricas">
        <div class="metrica">
          <span class="metrica-label">Tasa de retención</span>
          <span class="metrica-valor">{fmtPct(tasaRetencion)}</span>
          <span class="metrica-nota">retenciones ÷ aptas</span>
        </div>
        <div class="metrica">
          <span class="metrica-label">Retención sobre total</span>
          <span class="metrica-valor">{fmtPct(retencionSobreTotal)}</span>
          <span class="metrica-nota">sobre el total de llamadas</span>
        </div>
        <div class="metrica metrica-amarilla">
          <span class="metrica-label">Aptas sin retener</span>
          <span class="metrica-valor">{fmtInt(aptasSinRetener)}</span>
          <span class="metrica-nota">{fmtPct(pctSinRetenerSobreAptas)} de las aptas</span>
        </div>
      </section>

      <!-- Composición Inbound / Outbound -->
      <section class="composicion">
        <div class="fila-composicion">
          <span class="punto" style={{ background: '#8b5cf6' }}></span>
          <span class="etiqueta">Inbound</span>
          <span class="valor">{fmt.format(IN)}</span>
          <span class="porcentaje">{fmtPct(pctInbound)}</span>
        </div>
        <div class="fila-composicion">
          <span class="punto" style={{ background: '#06b6d4' }}></span>
          <span class="etiqueta">Outbound</span>
          <span class="valor">{fmt.format(OUT)}</span>
          <span class="porcentaje">{fmtPct(pctOutbound)}</span>
        </div>
      </section>

      <!-- Tabla detalle por cabina -->
      <section class="detalle-tabla">
        <div class="tabla-head">DETALLE POR CABINA</div>
        <table class="tabla-cabina">
          <thead>
            <tr>
              <th>CABINA</th>
              <th class="num">LLAMADAS</th>
              <th class="num">APTAS</th>
              <th class="num">NO APTAS</th>
              <th class="num">RETENCIONES</th>
              <th class="num">% RET. S/ APTAS</th>
              <th class="num">% RET. S/ TOTAL</th>
            </tr>
          </thead>
          <tbody>
            {[
              { label: 'Inbound', color: '#8b5cf6', llamadas: IN, aptas: n(inboundAptas), noAptas: n(inboundNoAptas), retenciones: n(inboundRetenciones) },
              { label: 'Outbound', color: '#06b6d4', llamadas: OUT, aptas: n(outboundAptas), noAptas: n(outboundNoAptas), retenciones: n(outboundRetenciones) },
              { label: 'Total', color: '#3b82f6', llamadas: T, aptas: APT, noAptas: NOAP, retenciones: RET, esTotal: true },
            ].map((r, i) => {
              const pctRetAptas = r.aptas > 0 ? (r.retenciones / r.aptas) * 100 : 0;
              const pctRetTotal = r.llamadas > 0 ? (r.retenciones / r.llamadas) * 100 : 0;
              return (
                <tr class={r.esTotal ? 'fila-total' : ''}>
                  <td><span class="punto-tabla" style={{ background: r.color }}></span>{r.label}</td>
                  <td class="num">{fmt.format(r.llamadas)}</td>
                  <td class="num">{fmt.format(r.aptas)}</td>
                  <td class="num">{fmt.format(r.noAptas)}</td>
                  <td class="num">{fmt.format(r.retenciones)}</td>
                  <td class="num">{fmtPct(pctRetAptas)}</td>
                  <td class="num">{fmtPct(pctRetTotal)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <p class="nota-pie">
        Las no aptas no generan retención. Retenidos = RETENIDO + CANCELADO + VENTA.
      </p>
    </div>
  </div>
</article>

<style>
  .embudo-contenedor {
    /* Separación clara respecto al gráfico mensual de arriba (tarjeta independiente) */
    margin-top: 40px;
    background: var(--cpanel-fondo);
    background-image: var(--cglass-bg);
    border: 1px solid var(--cglass-borde);
    border-radius: 1.5rem;
    padding: 1.25rem 1.5rem;
    box-shadow: var(--csombra-panel);
    backdrop-filter: blur(18px);
  }
  .embudo-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .embudo-titulo {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    color: var(--ctinta);
  }
  .embudo-subtitulo {
    font-size: 0.8rem;
    font-weight: 600;
    color: color-mix(in srgb, currentColor 50%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .embudo-layout {
    display: grid;
    grid-template-columns: clamp(240px, 32%, 300px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .embudo-columna-izq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .embudo-columna-der {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .embudo-svg {
    width: 100%;
    max-width: 300px;
    max-height: 340px;
    height: auto;
    display: block;
  }

  /* Capas del embudo */
  .capa {
    animation: embudoCapaIn .7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    transform-box: fill-box;
    transform-origin: 50% 0;
  }
  @keyframes embudoCapaIn {
    from { opacity: 0; transform: translateY(-18px) scale(.97); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .capa { animation: none; } }

  .texto-etiqueta {
    fill: #ffffff;
    font-weight: 800;
    font-size: 9.5px;
    font-family: 'Raleway', sans-serif;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-anchor: middle;
    user-select: none;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.38);
    stroke-width: 1.8px;
    stroke-linejoin: round;
  }
  .texto-valor {
    fill: #ffffff;
    font-weight: 800;
    font-size: 18px;
    font-family: 'Raleway', sans-serif;
    text-anchor: middle;
    user-select: none;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.42);
    stroke-width: 2.4px;
    stroke-linejoin: round;
  }
  .texto-pct {
    fill: #ffffff;
    font-weight: 600;
    font-size: 9px;
    font-family: 'Raleway', sans-serif;
    text-anchor: middle;
    opacity: 0.98;
    user-select: none;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.4);
    stroke-width: 1.7px;
    stroke-linejoin: round;
  }

  /* Métricas clave */
  .metricas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .metrica {
    border: 1px solid var(--cglass-borde);
    border-radius: 1rem;
    padding: 0.75rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
    text-align: center;
  }
  .metrica-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, currentColor 50%, transparent);
    display: block;
    margin-bottom: 0.25rem;
  }
  .metrica-valor {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ctinta);
    font-variant-numeric: tabular-nums;
    display: block;
    margin-bottom: 0.15rem;
  }
  .metrica-nota {
    font-size: 0.65rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    display: block;
  }
  .metrica-amarilla .metrica-valor { color: #b45309; }
  :global(.dark) .metrica-amarilla .metrica-valor { color: #fcd34d; }

  /* Composición Inbound / Outbound */
  .composicion {
    border: 1px solid var(--cglass-borde);
    border-radius: 1rem;
    padding: 0.75rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
  }
  .fila-composicion {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .fila-composicion:last-child { margin-bottom: 0; }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .etiqueta {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ctinta);
    min-width: 55px;
  }
  .valor {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--ctinta);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .porcentaje {
    font-size: 0.75rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    margin-left: auto;
    margin-right: 0.5rem;
  }

  /* Tabla detalle por cabina */
  .detalle-tabla { display: flex; flex-direction: column; gap: 0.5rem; overflow-x: auto; }
  .tabla-head {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, currentColor 50%, transparent);
  }
  .tabla-cabina {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .tabla-cabina th {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, currentColor 50%, transparent);
    padding: 0.5rem 0.4rem;
    text-align: right;
    border-bottom: 1px solid var(--cglass-borde);
  }
  .tabla-cabina th:first-child { text-align: left; padding-left: 0.4rem; }
  .tabla-cabina td {
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .tabla-cabina td:first-child {
    text-align: left;
    padding-left: 0.4rem;
    font-weight: 700;
    color: var(--ctinta);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tabla-cabina td .punto-tabla {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .tabla-cabina td.num { text-align: right; font-weight: 700; color: var(--ctinta); }
  .tabla-cabina .fila-total td {
    font-weight: 800;
    color: var(--ctinta);
    border-top: 1.5px solid var(--cglass-borde);
    border-bottom: none;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .nota-pie {
    font-size: 0.7rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .embudo-contenedor { margin-top: 24px; }
    .embudo-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .embudo-columna-izq {
      max-width: 480px;
      margin: 0 auto;
      align-items: center;
    }
    .metricas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .metricas { grid-template-columns: 1fr; }
    .tabla-cabina { font-size: 0.7rem; }
    .tabla-cabina th, .tabla-cabina td { padding: 0.4rem 0.2rem; }
  }
</style>