---
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptos: number;
  noAptos: number;
  retenciones: number;
  pct: number;
}
const { total, inbound, outbound, aptos, noAptos, retenciones, pct } = Astro.props;
const fmt = new Intl.NumberFormat('es-CO');

const maxVal = Math.max(total || 1, 1);
// Solo se muestran los pasos con datos (>0) para la gasera/filtro actual
// (ej. CEO no tiene outbound, Efigas no tiene inbound).
// Se ordenan de mayor a menor para que el embudo vaya estrechándose.
const steps = [
  { key: 'total', label: 'Total llamadas', value: total, color: '#120180' },
  { key: 'inbound', label: 'Inbound', value: inbound, color: '#00cd93' },
  { key: 'outbound', label: 'Outbound', value: outbound, color: '#475569' },
  { key: 'aptos', label: 'Aptos', value: aptos, color: '#0d9488' },
  { key: 'noAptos', label: 'No Aptos', value: noAptos, color: '#f43f5e' },
  { key: 'retenciones', label: 'Retenciones', value: retenciones, color: '#2563eb' },
]
  .filter((s) => (s.value ?? 0) > 0)
  .sort((a, b) => (b.value ?? 0) - (a.value ?? 0))
  .map((s) => ({
    ...s,
    pctOfTotal: maxVal > 0 ? (s.value / maxVal) * 100 : 0,
    pctOfPrev: 0,
  }));
for (let i = 1; i < steps.length; i++) {
  const prev = steps[i - 1].value || 1;
  steps[i].pctOfPrev = (steps[i].value / prev) * 100;
}
const pctRetencion = pct;

const stepHeight = 34;
const gap = 4;
const svgHeight = steps.length * (stepHeight + gap) + 32;
const svgWidth = 300;
const maxFunnelWidth = 230;
const minFunnelWidth = 80;
const funnelOffsetX = (svgWidth - maxFunnelWidth) / 2;
---
<section class="glass mt-3 rounded-3xl p-4 md:p-5">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 text-base font-bold md:text-lg">
      <span class="kpi-ico kpi-ico-sm" style="background:linear-gradient(135deg,#120180,#3d22c8)">▾</span>
      Embudo de gestión
    </h2>
    <p class="text-xs text-tinta/60">Total → Cabina → Clasificación → Retención</p>
  </div>
  <div class="mt-3 flex flex-col items-center gap-4 md:flex-row md:items-start">
    <div class="w-full md:w-1/2">
      <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} preserveAspectRatio="xMidYMid meet" class="w-full h-auto">
        <defs>
          <linearGradient id="funnelGradPromi" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#120180" stop-opacity="0.85" />
            <stop offset="100%" stop-color="#00cd93" stop-opacity="0.85" />
          </linearGradient>
        </defs>
        <g transform={`translate(${funnelOffsetX}, 6)`}>
          {steps.map((step, i) => {
            const width = Math.max((step.pctOfTotal / 100) * maxFunnelWidth, minFunnelWidth);
            const x = (maxFunnelWidth - width) / 2;
            const y = i * (stepHeight + gap);
            const isLast = i === steps.length - 1;
            const nextWidth = isLast
              ? Math.max(width - 8, minFunnelWidth)
              : Math.max((steps[i + 1].pctOfTotal / 100) * maxFunnelWidth, minFunnelWidth);
            const nextX = (maxFunnelWidth - nextWidth) / 2;
            const centerX = maxFunnelWidth / 2;
            const centerY = y + stepHeight / 2;
            return (
              <g key={step.key} class="cursor-default">
                <title>{`${step.label}: ${fmt.format(step.value)} (${step.pctOfTotal.toFixed(1)}%)`}</title>
                <path
                  d={isLast
                    ? `M ${x} ${y} L ${x + width} ${y} L ${x + width - 5} ${y + stepHeight} L ${x + 5} ${y + stepHeight} Z`
                    : `M ${x} ${y} L ${x + width} ${y} L ${nextX + nextWidth} ${y + stepHeight} L ${nextX} ${y + stepHeight} Z`}
                  fill={step.color}
                  fill-opacity="0.88"
                  stroke="rgba(255,255,255,0.14)"
                  stroke-width="0.5"
                />
                <text x={centerX} y={centerY - 7.5} text-anchor="middle" dominant-baseline="central" font-size="9" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {step.label}
                </text>
                <text x={centerX} y={centerY + 0.5} text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {fmt.format(step.value)}
                </text>
                <text x={centerX} y={centerY + 9} text-anchor="middle" dominant-baseline="central" font-size="7.5" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">
                  {step.pctOfTotal.toFixed(1)}%
                </text>
              </g>
            );
          })}
          <g transform={`translate(${maxFunnelWidth / 2}, ${steps.length * (stepHeight + gap) + 6})`}>
            <text x={0} y={0} text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="800" fill="currentColor">
              % Ret: {pct.toFixed(1)}%
            </text>
            <text x={0} y={12} text-anchor="middle" dominant-baseline="central" font-size="7" fill="#94a3b8">
              (Ret/Aptos)
            </text>
          </g>
        </g>
      </svg>
    </div>
    <div class="w-full md:w-1/2">
      <ul class="space-y-2 text-sm">
        {steps.map((s) => (
          <li class="flex items-center justify-between gap-3 rounded-xl border border-tinta/10 bg-tinta/5 px-3 py-2">
            <span class="flex items-center gap-2 font-bold">
              <span class="inline-block h-3 w-3 rounded" style={`background:${s.color}`}></span>
              {s.label}
            </span>
            <span class="font-extrabold tabular-nums">{fmt.format(s.value)}</span>
          </li>
        ))}
        <li class="flex items-center justify-between gap-3 rounded-xl border border-tinta/10 bg-tinta/5 px-3 py-2">
          <span class="font-bold">% Retención</span>
          <span class="font-extrabold tabular-nums">{pct.toFixed(1)}%</span>
        </li>
      </ul>
    </div>
  </div>
</section>
