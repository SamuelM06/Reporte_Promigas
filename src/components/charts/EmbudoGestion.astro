---
// Embudo de gestión reestructurado (solicitud del usuario):
// Nivel 1: Total general (ancho completo)
// Nivel 2: Aptos (izq, ~83%) + No aptos (der, ~17%) lado a lado
// Nivel 3: Retenidos (centrado bajo Aptos)
// Nivel 4: % Retención (centrado bajo Retenidos)
// Sin bloques flotantes; silueta continua de embudo, grande y protagonista.
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptos: number;
  noAptos: number;
  retenciones: number;
  pct: number;
}
const { total, inbound, outbound, aptos, noAptos, retenciones, pct } = Astro.props;
const fmt = new Intl.NumberFormat('es-CO');
const n = (v: number | undefined) => Number(v ?? 0) || 0;

const T = n(total);
const A = n(aptos);
const NA = n(noAptos);
const R = n(retenciones);
const PCT = pct;

const pctA = T > 0 ? (A / T) * 100 : 0;
const pctNA = T > 0 ? (NA / T) * 100 : 0;
const pctR = T > 0 ? (R / T) * 100 : 0;

// Geometría del embudo
const svgWidth = 320;
const maxW = 272;          // ancho del nivel 1 (Total general)
const gapX = 6;            // separación entre Aptos y No aptos
const gapY = 10;           // separación vertical entre niveles
const H1 = 74;             // alto nivel 1
const H2 = 68;             // alto nivel 2 (Aptos/No aptos)
const H3 = 62;             // alto nivel 3 (Retenidos)
const H4 = 56;             // alto nivel 4 (% Retención)
const taper = 0.94;        // factor de estrechamiento por nivel

// Nivel 1: Total general
const L1 = { top: maxW, bottom: Math.round(maxW * taper), h: H1, x: 0, y: 0 };

// Nivel 2: Aptos + No aptos lado a lado, mismo ancho combinado que L1.bottom
const availW = L1.bottom;
let aptosW = Math.max(130, Math.round(availW * (pctA / 100)));
let noAptosW = Math.max(52, Math.round(availW * (pctNA / 100)));
// Ajustar para que aptosW + gapX + noAptosW = availW
const sum2 = aptosW + gapX + noAptosW;
if (sum2 !== availW) {
  const diff = availW - sum2;
  aptosW = aptosW + diff; // absorber la diferencia en Aptos
}
const L2 = {
  aptos: { top: aptosW, bottom: Math.round(aptosW * taper), h: H2, x: 0, y: L1.h + gapY },
  noAptos: { top: noAptosW, bottom: Math.round(noAptosW * taper), h: H2, x: aptosW + gapX, y: L1.h + gapY },
};

// Nivel 3: Retenidos, centrado bajo el bloque Aptos
const aptosCenterX = L2.aptos.x + L2.aptos.top / 2;
const retW = Math.max(86, Math.round(L2.aptos.top * (R / Math.max(A, 1))));
const L3 = { top: retW, bottom: Math.round(retW * taper), h: H3, x: Math.round(aptosCenterX - retW / 2), y: L2.aptos.y + H2 + gapY };

// Nivel 4: % Retención, centrado bajo Retenidos
const retCenterX = L3.x + L3.top / 2;
const pctW = Math.max(74, Math.round(L3.top * 0.86));
const L4 = { top: pctW, bottom: Math.round(pctW * taper), h: H4, x: Math.round(retCenterX - pctW / 2), y: L3.y + H3 + gapY };

const svgHeight = L4.y + H4 + 18;
const offsetX = (svgWidth - maxW) / 2;

// Helper: trapezoide centrado (topW arriba, bottomW abajo, centrado en x+width/2)
function trap(x: number, y: number, topW: number, bottomW: number, h: number, r = 10): string {
  const cx = x + topW / 2;
  const topL = cx - topW / 2;
  const topR = cx + topW / 2;
  const botL = cx - bottomW / 2;
  const botR = cx + bottomW / 2;
  // path con esquinas redondeadas aproximadas vía rect? Usamos polygon simple + rx en rect overlay no. Usamos path con arcs.
  return `M ${topL + r} ${y} L ${topR - r} ${y} Q ${topR} ${y} ${topR} ${y + r} L ${botR} ${y + h - r} Q ${botR} ${y + h} ${botR - r} ${y + h} L ${botL + r} ${y + h} Q ${botL} ${y + h} ${botL} ${y + h - r} L ${topL} ${y + r} Q ${topL} ${y} ${topL + r} ${y} Z`;
}

// Iconos (Lucide, stroke 1.6, ~22-24px) — se dibujan dentro de cada nivel
const iconPhone = '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><path d="M14.05 2.5a9 9 0 0 1 7.45 7.45"/><path d="M14.05 6.3a5.2 5.2 0 0 1 3.6 3.63"/>';
const iconCheck = '<circle cx="12" cy="12" r="10"/><path d="m8.5 12.5 2.5 2.5 5-6"/>';
const iconX = '<circle cx="12" cy="12" r="10"/><path d="m9.5 9.5 5 5"/><path d="m14.5 9.5-5 5"/>';
const iconShield = '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12.5 2.2 2.2 4.4-4.5"/>';
const iconPct = '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>';

// Detalles de la gestión (panel derecho)
const pctFila = (v: number) => (T > 0 ? (n(v) / T) * 100 : 0);
const shareIn = pctFila(inbound);
const shareOut = pctFila(outbound);
const shareAptos = pctFila(aptos);
const shareNoAptos = pctFila(noAptos);
---
<section class="glass mt-3 rounded-3xl p-4 md:p-5">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="flex items-center gap-2 text-base font-bold md:text-lg">
      <span class="kpi-ico kpi-ico-sm" style="background:linear-gradient(135deg,#120180,#3d22c8)">▾</span>
      Embudo de gestión
    </h2>
    <p class="text-[11px] font-semibold text-tinta/60 md:text-xs">Total general → Aptos / No aptos → Retenidos → % Retención</p>
  </div>

  <div class="mt-3 grid items-start gap-4 md:grid-cols-[auto_1fr]">
    <!-- SVG del embudo -->
    <div class="mx-auto w-full max-w-sm md:mx-0 md:w-[320px]">
      <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} preserveAspectRatio="xMidYMid meet" class="w-full h-auto" role="img" aria-label="Embudo de gestión">
        <defs>
          <linearGradient id="pctGradPromi" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1e40af" />
            <stop offset="100%" stop-color="#3b82f6" />
          </linearGradient>
        </defs>
        <g transform={`translate(${offsetX}, 4)`}>
          <!-- Nivel 1: Total general -->
          <g>
            <title>{`Total general: ${fmt.format(T)} (100%)`}</title>
            <path d={trap(L1.x, L1.y, L1.top, L1.bottom, L1.h)} fill="#120180" fill-opacity="0.9" stroke="rgba(255,255,255,0.14)" stroke-width="0.5" />
            <g transform={`translate(${L1.x + 16}, ${L1.y + 12})`}>
              <circle cx="11" cy="11" r="11" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.28)" stroke-width="0.6" />
              <g transform="translate(11,11) scale(0.9) translate(-12,-12)" stroke="white" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={iconPhone} />
            </g>
            <text x={L1.x + L1.top / 2} y={L1.y + L1.h / 2 - 11} text-anchor="middle" dominant-baseline="central" font-size="9" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">Total general</text>
            <text x={L1.x + L1.top / 2} y={L1.y + L1.h / 2 + 4} text-anchor="middle" dominant-baseline="central" font-size="24" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{fmt.format(T)}</text>
            <text x={L1.x + L1.top / 2} y={L1.y + L1.h / 2 + 20} text-anchor="middle" dominant-baseline="central" font-size="8" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">100% del total</text>
          </g>

          <!-- Nivel 2: Aptos (izq) + No aptos (der) -->
          <g>
            <title>{`Aptos: ${fmt.format(A)} (${pctA.toFixed(1)}%)`}</title>
            <path d={trap(L2.aptos.x, L2.aptos.y, L2.aptos.top, L2.aptos.bottom, L2.aptos.h)} fill="#0d9488" fill-opacity="0.9" stroke="rgba(255,255,255,0.14)" stroke-width="0.5" />
            <g transform={`translate(${L2.aptos.x + 12}, ${L2.aptos.y + 10})`}>
              <circle cx="11" cy="11" r="11" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.28)" stroke-width="0.6" />
              <g transform="translate(11,11) scale(0.85) translate(-12,-12)" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={iconCheck} />
            </g>
            <text x={L2.aptos.x + L2.aptos.top / 2} y={L2.aptos.y + L2.aptos.h / 2 - 10} text-anchor="middle" dominant-baseline="central" font-size="9" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">Aptos</text>
            <text x={L2.aptos.x + L2.aptos.top / 2} y={L2.aptos.y + L2.aptos.h / 2 + 4} text-anchor="middle" dominant-baseline="central" font-size="22" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{fmt.format(A)}</text>
            <text x={L2.aptos.x + L2.aptos.top / 2} y={L2.aptos.y + L2.aptos.h / 2 + 18} text-anchor="middle" dominant-baseline="central" font-size="7.5" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{pctA.toFixed(1)}% del total</text>
          </g>
          <g>
            <title>{`No aptos: ${fmt.format(NA)} (${pctNA.toFixed(1)}%)`}</title>
            <path d={trap(L2.noAptos.x, L2.noAptos.y, L2.noAptos.top, L2.noAptos.bottom, L2.noAptos.h)} fill="#f43f5e" fill-opacity="0.9" stroke="rgba(255,255,255,0.14)" stroke-width="0.5" />
            <g transform={`translate(${L2.noAptos.x + Math.max(4, (L2.noAptos.top - 22) / 2)}, ${L2.noAptos.y + 10})`}>
              <circle cx="11" cy="11" r="11" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.28)" stroke-width="0.6" />
              <g transform="translate(11,11) scale(0.85) translate(-12,-12)" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={iconX} />
            </g>
            <text x={L2.noAptos.x + L2.noAptos.top / 2} y={L2.noAptos.y + L2.noAptos.h / 2 - 10} text-anchor="middle" dominant-baseline="central" font-size="8.5" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">No aptos</text>
            <text x={L2.noAptos.x + L2.noAptos.top / 2} y={L2.noAptos.y + L2.noAptos.h / 2 + 4} text-anchor="middle" dominant-baseline="central" font-size="16" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{fmt.format(NA)}</text>
            <text x={L2.noAptos.x + L2.noAptos.top / 2} y={L2.noAptos.y + L2.noAptos.h / 2 + 18} text-anchor="middle" dominant-baseline="central" font-size="7" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{pctNA.toFixed(1)}%</text>
          </g>

          <!-- Nivel 3: Retenidos (centrado bajo Aptos) -->
          <g>
            <title>{`Retenidos: ${fmt.format(R)} (${pctR.toFixed(1)}% del total)`}</title>
            <path d={trap(L3.x, L3.y, L3.top, L3.bottom, L3.h)} fill="#2563eb" fill-opacity="0.9" stroke="rgba(255,255,255,0.14)" stroke-width="0.5" />
            <g transform={`translate(${L3.x + (L3.top - 22) / 2}, ${L3.y + 8})`}>
              <circle cx="11" cy="11" r="11" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.28)" stroke-width="0.6" />
              <g transform="translate(11,11) scale(0.85) translate(-12,-12)" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={iconShield} />
            </g>
            <text x={L3.x + L3.top / 2} y={L3.y + L3.h / 2 - 6} text-anchor="middle" dominant-baseline="central" font-size="8.5" font-weight="700" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">Retenidos</text>
            <text x={L3.x + L3.top / 2} y={L3.y + L3.h / 2 + 8} text-anchor="middle" dominant-baseline="central" font-size="20" font-weight="800" fill="white" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{fmt.format(R)}</text>
            <text x={L3.x + L3.top / 2} y={L3.y + L3.h / 2 + 22} text-anchor="middle" dominant-baseline="central" font-size="7" font-weight="600" fill="rgba(255,255,255,0.9)" style="text-shadow:0 1px 2px rgba(0,0,0,.45)">{pctR.toFixed(1)}% del total</text>
          </g>

          <!-- Nivel 4: % Retención (centrado bajo Retenidos) -->
          <g>
            <path d={trap(L4.x, L4.y, L4.top, L4.bottom, L4.h)} fill="url(#pctGradPromi)" stroke="rgba(255,255,255,0.18)" stroke-width="0.5" />
            <g transform={`translate(${L4.x + (L4.top - 22) / 2}, ${L4.y + 6})`}>
              <circle cx="11" cy="11" r="11" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.28)" stroke-width="0.6" />
              <g transform="translate(11,11) scale(0.85) translate(-12,-12)" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={iconPct} />
            </g>
            <text x={L4.x + L4.top / 2} y={L4.y + L4.h / 2 - 4} text-anchor="middle" dominant-baseline="central" font-size="7.5" font-weight="700" fill="rgba(255,255,255,0.92)">% Retención</text>
            <text x={L4.x + L4.top / 2} y={L4.y + L4.h / 2 + 9} text-anchor="middle" dominant-baseline="central" font-size="15" font-weight="800" fill="#fff">{PCT.toFixed(1)}%</text>
          </g>
        </g>
      </svg>
    </div>

    <!-- Panel de detalles (derecha) -->
    <div class="w-full space-y-2">
      <ul class="grid grid-cols-2 gap-1.5 text-[11px] sm:grid-cols-3 lg:grid-cols-6 md:grid-cols-3">
        {[
          { label: 'Total general', value: T, color: '#120180', pct: 100 },
          { label: 'Inbound', value: n(inbound), color: '#8b5cf6', pct: shareIn },
          { label: 'Outbound', value: n(outbound), color: '#06b6d4', pct: shareOut },
          { label: 'Aptos', value: A, color: '#0d9488', pct: shareAptos },
          { label: 'No aptos', value: NA, color: '#f43f5e', pct: shareNoAptos },
          { label: 'Retenidos', value: R, color: '#2563eb', pct: pctR },
        ].map((s) => (
          <li class="rounded-xl border border-tinta/10 bg-tinta/5 px-2 py-1.5">
            <span class="flex items-center gap-1.5 font-bold text-tinta/80">
              <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-sm" style={`background:${s.color}`}></span>
              <span class="truncate">{s.label}</span>
            </span>
            <span class="mt-0.5 block text-sm font-extrabold tabular-nums leading-tight text-tinta">{fmt.format(s.value)}</span>
            <span class="block text-[10px] font-semibold tabular-nums text-tinta/55">{s.pct.toFixed(1)}% del total</span>
          </li>
        ))}
      </ul>

      <div class="rounded-2xl border border-tinta/10 bg-tinta/5 p-3 md:p-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-tinta/55">Detalles de la gestión</p>
        <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[11px] sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <span class="text-tinta/60">Share inbound</span>
            <p class="font-extrabold tabular-nums">{shareIn.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(inbound))})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">Share outbound</span>
            <p class="font-extrabold tabular-nums">{shareOut.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(n(outbound))})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">Aptas sobre total</span>
            <p class="font-extrabold tabular-nums text-teal-700 dark:text-teal-400">{shareAptos.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(A)})</span></p>
          </div>
          <div>
            <span class="text-tinta/60">No aptas sobre total</span>
            <p class="font-extrabold tabular-nums text-rose-600 dark:text-rose-400">{shareNoAptos.toFixed(1)}% <span class="font-semibold text-tinta/50">({fmt.format(NA)})</span></p>
          </div>
        </div>
        <div class="mt-3 flex flex-col gap-2 border-t border-tinta/10 pt-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="text-[11px] text-tinta/60">
            Retenidos = <span class="font-bold text-tinta/85">RETENIDO + CANCELADO + VENTA</span><br />
            Base de retención: <span class="font-bold text-tinta/85">solo Aptas</span>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-blue-600/20 bg-blue-600/10 px-3 py-2">
            <div class="text-right">
              <p class="text-[10px] font-bold uppercase tracking-widest text-blue-700 dark:text-blue-300">% Retención</p>
              <p class="text-xl font-extrabold tabular-nums leading-none text-blue-700 dark:text-blue-300">{PCT.toFixed(1)}%</p>
            </div>
            <div class="text-[10px] font-semibold leading-tight text-tinta/60">
              {fmt.format(R)} retenidos<br />
              de {fmt.format(A)} aptas
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
