---
// Embudo de gestión — estilo 3D (capas apiladas con efecto de volumen)
// Layout: [embudo ~40% | panel detalle ~60%]
// Props: total, inbound, outbound, aptas, noAptas, retenciones, pct,
//        inboundAptas, inboundNoAptas, inboundRetenciones,
//        outboundAptas, outboundNoAptas, outboundRetenciones
interface Props {
  total: number;
  inbound: number;
  outbound: number;
  aptas: number;
  noAptas: number;
  retenciones: number;
  pct: number;
  inboundAptas?: number;
  inboundNoAptas?: number;
  inboundRetenciones?: number;
  outboundAptas?: number;
  outboundNoAptas?: number;
  outboundRetenciones?: number;
}

const {
  total, inbound, outbound, aptas, noAptas, retenciones, pct,
  inboundAptas, inboundNoAptas, inboundRetenciones,
  outboundAptas, outboundNoAptas, outboundRetenciones,
} = Astro.props;

const fmt = new Intl.NumberFormat('es-CO');
const fmtPct = (v: number) => new Intl.NumberFormat('es-CO', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
}).format(v) + ' %';

import { fmtInt } from '../../lib/util';

const n = (v: unknown) => Number(v ?? 0) || 0;

const T = n(total);
const IN = n(inbound);
const OUT = n(outbound);
const APT = n(aptas);
const NOAP = noAptas != null ? n(noAptas) : Math.max(0, T - APT);
const RET = n(retenciones);

// Derivados protegidos contra división por 0
const pctAptas    = T > 0 ? (APT / T) * 100 : 0;
const pctNoAptas  = T > 0 ? (NOAP / T) * 100 : 0;
const aptasSinRetener = Math.max(0, APT - RET);
const pctSinRetenerSobreAptas = APT > 0 ? (aptasSinRetener / APT) * 100 : 0;
const tasaRetencion = APT > 0 ? (RET / APT) * 100 : 0;
const retencionSobreTotal = T > 0 ? (RET / T) * 100 : 0;
const pctInbound  = T > 0 ? (IN / T) * 100 : 0;
const pctOutbound = T > 0 ? (OUT / T) * 100 : 0;

// Anchos relativos de las 4 capas (mínimo 35% para que quepa el texto)
const minAncho = 35;
const wTotal = 100;
const wApt = Math.max(minAncho, pctAptas);
const wNoA = Math.max(minAncho, pctNoAptas);
const wRet = Math.max(minAncho, (T > 0 ? (RET / T) * 100 : 0));

// Altura del embudo (px)
const H_FUNNEL = 360;
const GAP_ENTRE_CAPAS = 14;
const altCapa = (H_FUNNEL - GAP_ENTRE_CAPAS * 3) / 4;
const ANCHO_MAX = 260;
const escala = ANCHO_MAX / 100;

// Posiciones Y de cada capa (apiladas)
let yActual = 0;
const posiciones: Array<{ y: number; h: number; w: number }> = [];
const anchosCapas = [wTotal, wApt, wNoA, wRet];
for (let i = 0; i < 4; i++) {
  posiciones.push({ y: yActual, h: altCapa, w: anchosCapas[i]! });
  yActual += altCapa + GAP_ENTRE_CAPAS;
}

// Paths SVG para cada capa (trapecio con elipse superior y borde inferior curvo)
function pathCuerpo(wSup: number, wInf: number, y: number, h: number): string {
  return `
    M ${-wSup/2},${y}
    Q 0,${y} ${wSup/2},${y}
    L ${-wInf/2},${y + h}
    Q 0,${y + h + 10} ${wInf/2},${y + h}
    L ${wSup/2},${y} Z
  `.trim();
}

// Tapa elíptica superior de cada capa
function pathTapa(wSup: number, y: number): string {
  const rx = wSup / 2;
  const ry = 12;
  return `
    M ${-rx},${y}
    Q ${-rx*0.55},${y} ${rx*0.55},${y} ${rx},${y}
    Q ${rx*0.55},${y} ${-rx*0.55},${y} ${-rx},${y} Z
  `.trim();
}

// Banda de sombra entre capas
function pathSombra(wSup: number, y: number): string {
  const rx = wSup / 2;
  return `
    M ${-rx},${y}
    Q 0,${y - 6} ${rx},${y}
    Q 0,${y + 4} ${-rx},${y} Z
  `.trim();
}

const capas = [
  { key: 'total',   label: 'TOTAL DE LLAMADAS', valor: T, w: wTotal, color: '#3b82f6', dark: '#2563eb' },
  { key: 'aptas',   label: 'APTAS',             valor: APT, w: wApt,  color: '#10a37f', dark: '#0f7a58' },
  { key: 'noaptas', label: 'NO APTAS',          valor: NOAP, w: wNoA,  color: '#d97706', dark: '#b45309' },
  { key: 'retenc',  label: 'RETENCIONES',       valor: RET, w: wRet,  color: '#0f7a58', dark: '#065f46' },
] as const;

// Sombra de suelo
const sueloW = wRet * escala * 0.9;
const sueloCY = posiciones[3]!.y + altCapa + 20;
---

<article class="embudo-contenedor">
  <header class="embudo-head">
    <h2 class="embudo-titulo">Embudo de gestión</h2>
    <span class="embudo-subtitulo">Total → Aptas → Retenciones</span>
  </header>

  <div class="embudo-layout">
    <!-- Columna izquierda: Embudo 3D -->
    <div class="embudo-columna-izq">
      <svg class="embudo-svg" viewBox="-140 0 280 420" aria-label="Embudo de gestión 3D">
        <defs>
          {capas.map((c) => (
            <linearGradient id={`grad-${c.key}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={c.color} stop-opacity="0.95" />
              <stop offset="100%" stop-color={c.dark} stop-opacity="0.95" />
            </linearGradient>
          ))}
        </defs>

        <!-- Sombra de suelo -->
        <ellipse cx="0" cy={sueloCY} rx={sueloW/2} ry={10} class="suelo" />

        <!-- Capas del embudo (de arriba hacia abajo) -->
        {capas.map((c, i) => {
          const pos = posiciones[i]!;
          const esUltima = i === capas.length - 1;
          const wSup = pos.w * escala;
          const wInf = i < capas.length - 1 ? posiciones[i + 1]!.w * escala : wSup * 0.55;
          const esRetenc = c.key === 'retenc';
          const esAptas = c.key === 'aptas';
          const esNoAptas = c.key === 'noaptas';
          const esTotal = c.key === 'total';
          return (
            <g class="capa">
              <!-- Tapa elíptica superior (más oscura) -->
              <path d={pathTapa(wSup, pos.y)} class="tapa" />
              <!-- Cuerpo de la capa (trapecio con degradado) -->
              <path d={pathCuerpo(wSup, wInf, pos.y, altCapa)} class="cuerpo" style={{ fill: `url(#grad-${c.key})` }} />
              <!-- Banda de sombra debajo de la capa (excepto la última) -->
              {!esUltima && (
                <path d={pathSombra(wSup, pos.y + altCapa)} class="banda-sombra" />
              )}
              <!-- Etiqueta -->
              <text x="0" y={pos.y + altCapa/2 + 6} class="texto-etiqueta">{c.label}</text>
              <!-- Valor -->
              <text x="0" y={pos.y + altCapa/2 + 26} class="texto-valor">{fmt.format(c.valor)}</text>
              <!-- Porcentaje segunda línea -->
              {esRetenc && (
                <text x="0" y={pos.y + altCapa/2 + 46} class="texto-pct">{fmtPct(tasaRetencion)} de retención</text>
              )}
              {!esRetenc && !esTotal && (
                <text x="0" y={pos.y + altCapa/2 + 46} class="texto-pct">{esAptas ? fmtPct(pctAptas) : fmtPct(pctNoAptas)} del total</text>
              )}
            </g>
          );
        })}
      </svg>
    </div>

    <!-- Columna derecha: Panel de detalle -->
    <div class="embudo-columna-der">
      <!-- Métricas clave -->
      <section class="metricas">
        <div class="metrica">
          <span class="metrica-label">Tasa de retención</span>
          <span class="metrica-valor">{fmtPct(tasaRetencion)}</span>
          <span class="metrica-nota">retenciones ÷ aptas</span>
        </div>
        <div class="metrica">
          <span class="metrica-label">Retención sobre total</span>
          <span class="metrica-valor">{fmtPct(retencionSobreTotal)}</span>
          <span class="metrica-nota">sobre el total de llamadas</span>
        </div>
        <div class="metrica metrica-amarilla">
          <span class="metrica-label">Aptas sin retener</span>
          <span class="metrica-valor">{fmtInt(aptasSinRetener)}</span>
          <span class="metrica-nota">{fmtPct(pctSinRetenerSobreAptas)} de las aptas</span>
        </div>
      </section>

      <!-- Composición Inbound / Outbound -->
      <section class="composicion">
        <div class="fila-composicion">
          <span class="punto" style={{ background: '#8b5cf6' }}></span>
          <span class="etiqueta">Inbound</span>
          <span class="valor">{fmt.format(IN)}</span>
          <span class="porcentaje">{fmtPct(pctInbound)}</span>
        </div>
        <div class="fila-composicion">
          <span class="punto" style={{ background: '#06b6d4' }}></span>
          <span class="etiqueta">Outbound</span>
          <span class="valor">{fmt.format(OUT)}</span>
          <span class="porcentaje">{fmtPct(pctOutbound)}</span>
        </div>
      </section>

      <!-- Tabla detalle por cabina -->
      <section class="detalle-tabla">
        <div class="tabla-head">DETALLE POR CABINA</div>
        <table class="tabla-cabina">
          <thead>
            <tr>
              <th>CABINA</th>
              <th class="num">LLAMADAS</th>
              <th class="num">APTAS</th>
              <th class="num">NO APTAS</th>
              <th class="num">RETENCIONES</th>
              <th class="num">% RET. S/ APTAS</th>
              <th class="num">% RET. S/ TOTAL</th>
            </tr>
          </thead>
          <tbody>
            {[
              { label: 'Inbound', color: '#8b5cf6', llamadas: IN, aptas: n(inboundAptas), noAptas: n(inboundNoAptas), retenciones: n(inboundRetenciones) },
              { label: 'Outbound', color: '#06b6d4', llamadas: OUT, aptas: n(outboundAptas), noAptas: n(outboundNoAptas), retenciones: n(outboundRetenciones) },
              { label: 'Total', color: '#3b82f6', llamadas: T, aptas: APT, noAptas: NOAP, retenciones: RET, esTotal: true },
            ].map((r, i) => {
              const pctRetAptas = r.aptas > 0 ? (r.retenciones / r.aptas) * 100 : 0;
              const pctRetTotal = r.llamadas > 0 ? (r.retenciones / r.llamadas) * 100 : 0;
              return (
                <tr class={r.esTotal ? 'fila-total' : ''}>
                  <td><span class="punto-tabla" style={{ background: r.color }}></span>{r.label}</td>
                  <td class="num">{fmt.format(r.llamadas)}</td>
                  <td class="num">{fmt.format(r.aptas)}</td>
                  <td class="num">{fmt.format(r.noAptas)}</td>
                  <td class="num">{fmt.format(r.retenciones)}</td>
                  <td class="num">{fmtPct(pctRetAptas)}</td>
                  <td class="num">{fmtPct(pctRetTotal)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <p class="nota-pie">
        Las no aptas no generan retención. Retenidos = RETENIDO + CANCELADO + VENTA.
      </p>
    </div>
  </div>
</article>

<style>
  :global(:root) {
    --suelo-opacity: 0.25;
    --banda-opacity: 0.15;
  }
  :global(.dark) {
    --suelo-opacity: 0.45;
    --banda-opacity: 0.35;
  }

  .embudo-contenedor {
    background: var(--cpanel-fondo);
    background-image: var(--cglass-bg);
    border: 1px solid var(--cglass-borde);
    border-radius: 1.5rem;
    padding: 1.25rem 1.5rem;
    box-shadow: var(--csombra-panel);
    backdrop-filter: blur(18px);
  }
  .embudo-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .embudo-titulo {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    color: var(--ctinta);
  }
  .embudo-subtitulo {
    font-size: 0.8rem;
    font-weight: 600;
    color: color-mix(in srgb, currentColor 50%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .embudo-layout {
    display: grid;
    grid-template-columns: 42% 58%;
    gap: 1.5rem;
    align-items: start;
  }
  .embudo-columna-izq {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 420px;
  }
  .embudo-columna-der {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .embudo-svg {
    width: 100%;
    max-width: 280px;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Capas del embudo */
  .tapa { fill: var(--ctinta-dim); }
  .cuerpo { stroke: none; }
  .banda-sombra { fill: #000000; fill-opacity: var(--banda-opacity); }
  .suelo { fill: #000000; fill-opacity: var(--suelo-opacity); }

  .texto-etiqueta {
    fill: #ffffff;
    font-weight: 800;
    font-size: 11px;
    font-family: 'Raleway', sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-anchor: middle;
    user-select: none;
  }
  .texto-valor {
    fill: #ffffff;
    font-weight: 800;
    font-size: 20px;
    font-family: 'Raleway', sans-serif;
    text-anchor: middle;
    user-select: none;
  }
  .texto-pct {
    fill: #ffffff;
    font-weight: 600;
    font-size: 11px;
    font-family: 'Raleway', sans-serif;
    text-anchor: middle;
    opacity: 0.9;
    user-select: none;
  }

  /* Métricas clave */
  .metricas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .metrica {
    border: 1px solid var(--cglass-borde);
    border-radius: 1rem;
    padding: 0.75rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
    text-align: center;
  }
  .metrica-label {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, currentColor 50%, transparent);
    display: block;
    margin-bottom: 0.25rem;
  }
  .metrica-valor {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ctinta);
    font-variant-numeric: tabular-nums;
    display: block;
    margin-bottom: 0.15rem;
  }
  .metrica-nota {
    font-size: 0.65rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    display: block;
  }
  .metrica-amarilla .metrica-valor { color: #b45309; }
  :global(.dark) .metrica-amarilla .metrica-valor { color: #fcd34d; }

  /* Composición Inbound / Outbound */
  .composicion {
    border: 1px solid var(--cglass-borde);
    border-radius: 1rem;
    padding: 0.75rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
  }
  .fila-composicion {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .fila-composicion:last-child { margin-bottom: 0; }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .etiqueta {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ctinta);
    min-width: 55px;
  }
  .valor {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--ctinta);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }
  .porcentaje {
    font-size: 0.75rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    margin-left: auto;
    margin-right: 0.5rem;
  }

  /* Tabla detalle por cabina */
  .detalle-tabla { display: flex; flex-direction: column; gap: 0.5rem; }
  .tabla-head {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, currentColor 50%, transparent);
  }
  .tabla-cabina {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .tabla-cabina th {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: color-mix(in srgb, currentColor 50%, transparent);
    padding: 0.5rem 0.4rem;
    text-align: right;
    border-bottom: 1px solid var(--cglass-borde);
  }
  .tabla-cabina th:first-child { text-align: left; padding-left: 0.4rem; }
  .tabla-cabina td {
    padding: 0.5rem 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    color: color-mix(in srgb, currentColor 70%, transparent);
  }
  .tabla-cabina td:first-child {
    text-align: left;
    padding-left: 0.4rem;
    font-weight: 700;
    color: var(--ctinta);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tabla-cabina td .punto-tabla {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .tabla-cabina td.num { text-align: right; font-weight: 700; color: var(--ctinta); }
  .tabla-cabina .fila-total td {
    font-weight: 800;
    color: var(--ctinta);
    border-top: 1.5px solid var(--cglass-borde);
    border-bottom: none;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .nota-pie {
    font-size: 0.7rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .embudo-layout {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .embudo-columna-izq {
      max-width: none;
      align-items: center;
    }
    .embudo-svg {
      max-width: 240px;
    }
    .metricas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 600px) {
    .embudo-svg { max-width: 200px; }
    .metricas { grid-template-columns: 1fr; }
    .tabla-cabina { font-size: 0.7rem; }
    .tabla-cabina th, .tabla-cabina td { padding: 0.4rem 0.2rem; }
  }
</style>