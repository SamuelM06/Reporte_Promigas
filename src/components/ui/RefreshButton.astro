---
// Botón "refrescar" del header: purga la caché del servidor y recarga la vista.
// Necesario porque la caché sirve datos stale hasta 30 min; sin esto, cargar
// siniestros nuevos en la BD no se ve en el portal hasta que expire.
---

<button
  id="btn-refrescar"
  type="button"
  title="Purgar la caché y recargar los datos desde la base de datos"
  aria-label="Refrescar datos"
  class="glass glass-hover inline-flex h-9 w-9 items-center justify-center rounded-xl text-tinta/70 transition-colors duration-200 hover:text-xuma-verde-oscuro dark:hover:text-xuma-verde-claro"
>
  <svg
    class="h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
    <path d="M21 3v5h-5"></path>
    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
    <path d="M8 16H3v5"></path>
  </svg>
</button>

<div id="toast-refrescar" class="pointer-events-none fixed bottom-5 left-1/2 z-50 -translate-x-1/2 opacity-0 transition-opacity duration-300" role="status" aria-live="polite">
  <div class="glass rounded-2xl px-4 py-2 text-xs font-semibold text-tinta shadow-lg"></div>
</div>

<style>
  /* El icono gira mientras corre la petición. `prefers-reduced-motion` lo
     desactiva junto con las animaciones del resto del portal. */
  #btn-refrescar.cargando svg {
    animation: girar 0.9s linear infinite;
  }
  #btn-refrescar:disabled {
    opacity: 0.55;
    cursor: progress;
  }
  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #btn-refrescar.cargando svg {
      animation: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('btn-refrescar');
  const toast = document.getElementById('toast-refrescar');

  if (btn) {
    btn.addEventListener('click', async () => {
      btn.classList.add('cargando');
      btn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/cache', { method: 'POST' });
        if (!res.ok) {
          const cuerpo = await res.json().catch(() => ({}));
          throw new Error(cuerpo.error ?? `HTTP ${res.status}`);
        }
        // Recarga la página solo si la purga fue efectiva: así los datos
        // salen de PostgreSQL y no de la caché que acabamos de vaciar.
        window.location.reload();
      } catch (err) {
        mostrarToast(`No se pudo refrescar: ${err instanceof Error ? err.message : 'error'}`);
        btn.classList.remove('cargando');
        btn.removeAttribute('disabled');
      }
    });
  }

  function mostrarToast(texto: string) {
    if (!toast) return;
    const caja = toast.firstElementChild;
    if (caja) caja.textContent = texto;
    toast.style.opacity = '1';
    window.setTimeout(() => {
      toast.style.opacity = '0';
    }, 4000);
  }
</script>
