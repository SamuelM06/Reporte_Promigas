---
import { FILTROS, ICONOS, type FiltroDef } from './filtros';

interface Props {
  action: string;
  defs?: FiltroDef[];
  opciones: Record<string, string[]>;
  actual: Record<string, string>;
  totalFiltrado: number;
  totalBase: number;
}

const {
  action,
  defs = FILTROS,
  opciones,
  actual,
  totalFiltrado,
  totalBase,
} = Astro.props;

const fmt = new Intl.NumberFormat('es-CO');
const chips = defs
  .map((d) => ({ label: d.label, valor: actual[d.key] ?? '' }))
  .filter((c) => c.valor !== '');
---

<form method="get" action={action} class="filtros-panel glass rounded-3xl p-4 md:p-5" data-filtros>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-tinta/55">
      <span class="filtro-titulo-ico" set:html={ICONOS.embudo} /> Filtros del reporte
    </p>
    <p class="text-xs font-bold text-tinta/60">
      {fmt.format(totalFiltrado)} registros con estos filtros · {fmt.format(totalBase)} en base
    </p>
  </div>

  <div class="filtros-grid">
    {defs.map((d) => (
      <label class="filtro">
        <span class="filtro-nombre"><span class="filtro-ico" set:html={d.icon} />{d.label}</span>
        <select name={d.param} class="filtro-sel">
          <option value="">{d.placeholder}</option>
          {(opciones[d.key] ?? []).map((op) => (
            <option value={op} selected={(actual[d.key] ?? '') === op}>{op}</option>
          ))}
        </select>
      </label>
    ))}
    <div class="flex items-end gap-2">
      <button type="submit" class="btn-filtrar" data-btn-filtrar>Filtrar</button>
      <a href={action} class="glass glass-hover inline-flex h-11 items-center rounded-xl px-4 text-sm font-semibold">Limpiar</a>
    </div>
  </div>

  {chips.length > 0 ? (
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-extrabold uppercase tracking-widest text-tinta/50">Activos:</span>
      {chips.map((c) => (
        <span class="chip-filtro"><strong>{c.label}:</strong> {c.valor}</span>
      ))}
    </div>
  ) : (
    <p class="mt-3 text-[11px] text-tinta/50">Sin filtros activos · mostrando todo el corte.</p>
  )}
</form>

<style>
  .filtros-grid { margin-top: .75rem; display: grid; gap: .8rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .filtros-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px) { .filtros-grid { grid-template-columns: repeat(4, minmax(0,1fr)) auto; align-items: end; } }
  .filtro { display: flex; flex-direction: column; gap: .25rem; min-width: 0; font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: color-mix(in srgb, currentColor 55%, transparent); }
  .filtro-nombre { display: inline-flex; align-items: center; gap: .4rem; }
  .filtro-ico { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; height: 1.5rem; color: var(--color-xuma-verde-oscuro); }
  :global(.dark) .filtro-ico { color: var(--color-xuma-verde-claro); }
  .filtro-ico :global(svg) { width: 1rem; height: 1rem; }
  .filtro-titulo-ico { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; color: var(--color-xuma-verde-oscuro); }
  :global(.dark) .filtro-titulo-ico { color: var(--color-xuma-verde-claro); }
  .filtro-titulo-ico :global(svg) { width: 1rem; height: 1rem; }
  .filtro-sel {
    height: 2.75rem; border-radius: .9rem; padding: 0 .8rem;
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    background: color-mix(in srgb, currentColor 5%, transparent);
    font-size: .85rem; font-weight: 700; text-transform: none; letter-spacing: normal; color: inherit;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  .filtro-sel:hover { transform: translateY(-1px); }
  .filtro-sel:focus { outline: none; border-color: var(--color-xuma-verde-oscuro); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-xuma-verde-oscuro) 25%, transparent); }
  .filtro-sel option { background: rgba(255,255,255,.82); color: #0a1030; font-weight: 600; }
  :global(.dark) .filtro-sel option { background: rgba(10,16,48,.88); color: #f4f6fb; }
  .btn-filtrar {
    height: 2.75rem; border-radius: .9rem; padding: 0 1.25rem;
    font-size: .85rem; font-weight: 800; color: #fff; background: var(--color-xuma-azul);
    box-shadow: 0 14px 28px -14px rgba(18,1,128,.55);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  :global(.dark) .btn-filtrar { background: var(--color-xuma-verde-claro); color: #0a1030; }
  .btn-filtrar:hover { transform: scale(1.05); }
  .btn-filtrar.is-loading { opacity: .7; pointer-events: none; }
  .chip-filtro {
    display: inline-flex; align-items: center; gap: .35rem;
    border-radius: 999px; padding: .35rem .8rem; font-size: .72rem;
    color: #fff; background: linear-gradient(135deg, var(--color-xuma-azul), var(--color-xuma-verde-oscuro));
    box-shadow: 0 10px 22px -12px rgba(18,1,128,.6);
    animation: chipIn .5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes chipIn { from { opacity: 0; transform: translateY(8px) scale(.94); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .chip-filtro { animation: none; } }
</style>

<script is:inline>
  // Al filtrar: estado de carga en el botón y fundido del gráfico (los gráficos
  // se re-animan solos al recargar con el filtro aplicado).
  (function () {
    document.querySelectorAll('[data-filtros]').forEach(function (form) {
      // Aplicado inmediato: al elegir un ítem se filtra solo, sin buscar el botón.
      form.querySelectorAll('select').forEach(function (sel) {
        sel.addEventListener('change', function () { form.requestSubmit(); });
      });
      form.addEventListener('submit', function () {
        var btn = form.querySelector('[data-btn-filtrar]');
        if (btn) { btn.classList.add('is-loading'); btn.textContent = 'Filtrando…'; }
        document.body.classList.add('filtrando');
      });
    });
  })();
</script>

<style is:inline>
  body.filtrando .chart-inner, body.filtrando .kpi-card { opacity: .35; transition: opacity .3s ease; }
</style>
